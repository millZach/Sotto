#: src/renderer/src/agents/OwnModelServers.tsx
msgid "(optional)"
msgstr "(optional)"

#. placeholder {0}: extra.length
#: src/renderer/src/agents/ownServerWords.ts
msgid "{0, plural, one {It also lists {names}, which is not added. To use it, remove the server and add it again.} other {It also lists {names}, which are not added. To use them, remove the server and add it again.}}"
msgstr "{0, plural, one {It also lists {names}, which is not added. To use it, remove the server and add it again.} other {It also lists {names}, which are not added. To use them, remove the server and add it again.}}"

#. placeholder {0}: gone.length
#: src/renderer/src/agents/ownServerWords.ts
msgid "{0, plural, one {It no longer lists {names}, so threads on it will fail until the server loads it again.} other {It no longer lists {names}, so threads on them will fail until the server loads them again.}}"
msgstr "{0, plural, one {It no longer lists {names}, so threads on it will fail until the server loads it again.} other {It no longer lists {names}, so threads on them will fail until the server loads them again.}}"

#: src/renderer/src/agents/ownServerWords.ts
msgid "{count, plural, one {# model} other {# models}}"
msgstr "{count, plural, one {# model} other {# models}}"

#. {derivedName} is the name Sotto takes from the address, such as spark-head.
#: src/renderer/src/agents/OwnModelServers.tsx
msgid "{derivedName}, from the address"
msgstr "{derivedName}, from the address"

#: src/renderer/src/agents/ownServerWords.ts
msgid "{host} answered but has no models loaded. Nothing was saved. Load a model on the server, then check again."
msgstr "{host} answered but has no models loaded. Nothing was saved. Load a model on the server, then check again."

#: src/renderer/src/agents/ownServerWords.ts
msgid "{host} asks for a key. Nothing was saved. Paste the key whoever runs the server gave you, then check again."
msgstr "{host} asks for a key. Nothing was saved. Paste the key whoever runs the server gave you, then check again."

#: src/renderer/src/agents/ownServerWords.ts
msgid "{host} is on the internet, so Sotto needs https:// to send it a key and your code. Use the server’s https address, or reach it over your tailnet."
msgstr "{host} is on the internet, so Sotto needs https:// to send it a key and your code. Use the server’s https address, or reach it over your tailnet."

#: src/renderer/src/agents/ownServerWords.ts
msgid "{host} turned down the key. Nothing was saved. Check the key with whoever runs the server, then try again."
msgstr "{host} turned down the key. Nothing was saved. Check the key with whoever runs the server, then try again."

#: src/renderer/src/agents/ownServerWords.ts
msgid "{name} answered in {ms} ms and asks for its key, which OpenCode keeps, so Sotto could not read its models again."
msgstr "{name} answered in {ms} ms and asks for its key, which OpenCode keeps, so Sotto could not read its models again."

#. {name} is the user’s own model server, such as Sparks.
#: src/renderer/src/agents/ownServerTurnWords.ts
msgid "{name} didn’t answer."
msgstr "{name} didn’t answer."

#. {five} is the number 5.
#: src/renderer/src/agents/ownServerTurnWords.ts
msgid "{name} didn’t start answering within {five} minutes."
msgstr "{name} didn’t start answering within {five} minutes."

#. {name} is the user’s own model server, such as Sparks. "(3 of 10)": the try OpenCode is on, of how many it makes.
#: src/renderer/src/agents/ownServerTurnWords.ts
msgid "{name} isn’t answering. Trying again ({tried} of {of})."
msgstr "{name} isn’t answering. Trying again ({tried} of {of})."

#. {model} is a model’s name, such as DeepSeek V4.1 Flash.
#: src/renderer/src/agents/ownServerTurnWords.ts
msgid "{name} no longer has {model}."
msgstr "{name} no longer has {model}."

#: src/renderer/src/agents/ownServerTurnWords.ts
msgid "{name} turned down its key."
msgstr "{name} turned down its key."

#. {who} is a server program such as Ollama; {count} is a number of models, as in "2 models".
#: src/renderer/src/agents/ownServerWords.ts
msgid "{who} answered in {ms} ms with {count}."
msgstr "{who} answered in {ms} ms with {count}."

#. {who} is a server program such as Ollama.
#: src/renderer/src/agents/ownServerWords.ts
msgid "{who} answered in {ms} ms."
msgstr "{who} answered in {ms} ms."

#. {five} is the number 5.
#: src/renderer/src/agents/ownServerTurnWords.ts
msgid "A long prompt can take a few minutes. The turn stops waiting at {five} minutes."
msgstr "A long prompt can take a few minutes. The turn stops waiting at {five} minutes."

#: src/renderer/src/agents/OwnModelServers.tsx
msgid "Add a server"
msgstr "Add a server"

#: src/renderer/src/agents/OwnModelServers.tsx
