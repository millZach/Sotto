msgid "{count, plural, one {# file} other {# files}}"
msgstr "{count, plural, one {# file} other {# files}}"

#: src/renderer/src/agents/bringChangesBack.logic.ts
msgid "{parentTitle} isn’t on {target} any more, and Sotto doesn’t switch branches. Switch it back to {target} there, then try again."
msgstr "{parentTitle} isn’t on {target} any more, and Sotto doesn’t switch branches. Switch it back to {target} there, then try again."

#: src/renderer/src/agents/bringChangesBack.logic.ts
msgid "{parentTitle} works on {target} in its worktree and sees them now."
