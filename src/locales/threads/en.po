msgstr "Done"

#: src/renderer/src/agents/OwnModelServers.tsx
msgid "From the address, if left empty"
msgstr "From the address, if left empty"

#: src/renderer/src/agents/OwnModelServers.tsx
msgid "It runs with OpenCode."
msgstr "It runs with OpenCode."

#: src/renderer/src/agents/ownServerTurnWords.ts
msgid "It took the message but sent nothing back. It may be busy, stuck or still reading a very long prompt. Nothing in the thread was lost. Check {name}, then try again."
msgstr "It took the message but sent nothing back. It may be busy, stuck or still reading a very long prompt. Nothing in the thread was lost. Check {name}, then try again."

#. A secret the model server checks before it answers.
#: src/renderer/src/agents/OwnModelServers.tsx
msgid "Key"
msgstr "Key"

#: src/renderer/src/agents/OwnModelServers.tsx
msgid "Key kept by OpenCode"
msgstr "Key kept by OpenCode"

#: src/renderer/src/agents/OwnModelServers.tsx
msgid "Model servers you run, such as Ollama, LM Studio, vLLM or SGLang, on this computer, your network or your tailnet. OpenCode threads can use their models. Sotto contacts a server only when you check or add it."
msgstr "Model servers you run, such as Ollama, LM Studio, vLLM or SGLang, on this computer, your network or your tailnet. OpenCode threads can use their models. Sotto contacts a server only when you check or add it."

#: src/renderer/src/agents/OwnModelServers.tsx
msgid "Models found"
msgstr "Models found"

#: src/renderer/src/agents/OwnModelServers.tsx
msgid "Name"
msgstr "Name"

#: src/renderer/src/agents/OwnModelServers.tsx
msgid "None yet. Add a model server you run to use its models in OpenCode threads."
msgstr "None yet. Add a model server you run to use its models in OpenCode threads."

#: src/renderer/src/agents/ownServerWords.ts
msgid "Nothing answered at {host}. Nothing was saved. Check the server is on and this computer can reach it, over the tailnet if it is there, then try again."
msgstr "Nothing answered at {host}. Nothing was saved. Check the server is on and this computer can reach it, over the tailnet if it is there, then try again."

#. Settings › Providers › Your own model servers is where the server is kept; translate each name as the Settings page does.
#: src/renderer/src/agents/ownServerTurnWords.ts
msgid "Nothing in the thread was lost. In Settings › Providers › Your own model servers, remove {name} and add it again with the right key, then try again."
msgstr "Nothing in the thread was lost. In Settings › Providers › Your own model servers, remove {name} and add it again with the right key, then try again."

#: src/renderer/src/agents/ownServerTurnWords.ts
msgid "Nothing in the thread was lost. Pick another model in the model menu below, or load {model} on {name} again, then try again."
msgstr "Nothing in the thread was lost. Pick another model in the model menu below, or load {model} on {name} again, then try again."

#: src/renderer/src/agents/OwnModelServers.tsx
msgid "Only if the server was started with one"
msgstr "Only if the server was started with one"

#: src/renderer/src/agents/ownServerTurnWords.ts
msgid "Open Settings"
msgstr "Open Settings"

#: src/renderer/src/agents/ownServerTurnWords.ts
msgid "Open Settings at Your own model servers"
msgstr "Open Settings at Your own model servers"

#: src/renderer/src/agents/ownServerWords.ts
msgid "OpenCode did not forget the key for {name}, so nothing was removed. Try removing the server again."
msgstr "OpenCode did not forget the key for {name}, so nothing was removed. Try removing the server again."

#: src/renderer/src/agents/ownServerWords.ts
msgid "OpenCode did not take the key for {name}, and Sotto could not take {name} back off its list, so it is saved without its key. Remove it, then add it again."
msgstr "OpenCode did not take the key for {name}, and Sotto could not take {name} back off its list, so it is saved without its key. Remove it, then add it again."

#: src/renderer/src/agents/ownServerWords.ts
msgid "OpenCode did not take the key for {name}, so nothing was saved. Try adding the server again."
msgstr "OpenCode did not take the key for {name}, so nothing was saved. Try adding the server again."

#: src/renderer/src/agents/ownServerWords.ts
msgid "OpenCode keeps the key in Sotto’s OpenCode folder, and Sotto keeps no copy."
msgstr "OpenCode keeps the key in Sotto’s OpenCode folder, and Sotto keeps no copy."

#: src/renderer/src/agents/ownServerWords.ts
msgid "OpenCode no longer has the key for {name}, but Sotto could not take {name} off its list. Remove it again."
msgstr "OpenCode no longer has the key for {name}, but Sotto could not take {name} off its list. Remove it again."

#. {ten} is the number 10. {host} is the server’s address and port, such as spark-head:8888; keep it as it is.
#: src/renderer/src/agents/ownServerTurnWords.ts
msgid "OpenCode tried it {ten} times over about a minute and a half. Nothing in the thread was lost. Check that {name} is on and this computer can reach {host}, then try again."
msgstr "OpenCode tried it {ten} times over about a minute and a half. Nothing in the thread was lost. Check that {name} is on and this computer can reach {host}, then try again."

#: src/renderer/src/agents/OwnModelServers.tsx
msgid "Read your saved servers again"
msgstr "Read your saved servers again"

#: src/renderer/src/agents/OwnModelServers.tsx
msgid "Reading your servers…"
msgstr "Reading your servers…"

#: src/renderer/src/agents/OwnModelServers.tsx
msgid "Remove"
msgstr "Remove"

#: src/renderer/src/agents/OwnModelServers.tsx
msgid "Remove {name}"
msgstr "Remove {name}"

#: src/renderer/src/agents/ownServerWords.ts
msgid "Removed {name}. Its models are gone from the model menu. Threads that used them keep their history; pick another model in them to go on."
msgstr "Removed {name}. Its models are gone from the model menu. Threads that used them keep their history; pick another model in them to go on."

#: src/renderer/src/agents/OwnModelServers.tsx
msgid "Removing…"
msgstr "Removing…"

#: src/renderer/src/agents/OwnModelServers.tsx
