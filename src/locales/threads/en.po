msgstr "Asking the server for its models…"

#: src/renderer/src/agents/OwnModelServers.tsx
msgid "Cancel"
msgstr "Cancel"

#: src/renderer/src/agents/OwnModelServers.tsx
msgid "Check {name} again"
msgstr "Check {name} again"

#: src/renderer/src/agents/OwnModelServers.tsx
msgid "Check again"
msgstr "Check again"

