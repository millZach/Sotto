msgstr "SGLang, vLLM, Ollama, LM Studio, llama.cpp or any OpenAI-compatible server. Check it, then add it, and OpenCode threads can use its models."

#: src/renderer/src/agents/ownServerWords.ts
msgid "Something answered at {host}, but not as an OpenAI-compatible server. Nothing was saved. Check the port and the path, such as http://localhost:11434/v1, then try again."
msgstr "Something answered at {host}, but not as an OpenAI-compatible server. Nothing was saved. Check the port and the path, such as http://localhost:11434/v1, then try again."

#: src/renderer/src/agents/ownServerWords.ts
msgid "Sotto could not finish that, so nothing was changed. Try again."
msgstr "Sotto could not finish that, so nothing was changed. Try again."

#: src/renderer/src/agents/ownServerWords.ts
msgid "Sotto could not reach its own side of this. Nothing was changed. Try again."
msgstr "Sotto could not reach its own side of this. Nothing was changed. Try again."

#: src/renderer/src/agents/ownServerWords.ts
msgid "Sotto could not reach its own side of this. Nothing was saved. Try again."
msgstr "Sotto could not reach its own side of this. Nothing was saved. Try again."

#: src/renderer/src/agents/OwnModelServers.tsx
msgid "Sotto could not read your saved servers. Nothing was changed. Try again."
msgstr "Sotto could not read your saved servers. Nothing was changed. Try again."

#: src/renderer/src/agents/ownServerWords.ts
msgid "Sotto could not remove {name}. Nothing was changed. Try again."
msgstr "Sotto could not remove {name}. Nothing was changed. Try again."

#: src/renderer/src/agents/ownServerWords.ts
msgid "Sotto keeps up to 32 servers. Remove one you no longer use, then add this one."
msgstr "Sotto keeps up to 32 servers. Remove one you no longer use, then add this one."

#: src/renderer/src/agents/ownServerWords.ts
msgid "Sotto’s OpenCode holds the key for {name} and is not running, so nothing was removed. Connect OpenCode under Providers, then remove the server again."
msgstr "Sotto’s OpenCode holds the key for {name} and is not running, so nothing was removed. Connect OpenCode under Providers, then remove the server again."

#. {name} is the user’s own model server, such as Sparks.
#: src/renderer/src/agents/ownServerTurnWords.ts
msgid "Still waiting for {name} to start answering."
msgstr "Still waiting for {name} to start answering."

#. Button on the line of a turn that is waiting on the user’s own model server: stops the turn.
#: src/renderer/src/agents/ownServerTurnWords.ts
msgid "Stop"
msgstr "Stop"

#: src/renderer/src/agents/ownServerTurnWords.ts
msgid "Stop agent"
msgstr "Stop agent"

#: src/renderer/src/agents/OwnModelServers.tsx
msgid "Takes images."
msgstr "Takes images."

#: src/renderer/src/agents/ownServerWords.ts
msgid "That is not an address Sotto can reach. Type it like http://localhost:11434 or http://spark-head:8888."
msgstr "That is not an address Sotto can reach. Type it like http://localhost:11434 or http://spark-head:8888."

#: src/renderer/src/agents/ownServerWords.ts
msgid "That server is no longer saved. Nothing was changed."
msgstr "That server is no longer saved. Nothing was changed."

#: src/renderer/src/agents/ownServerWords.ts
msgid "The server does not say how much context this model has. Type it from the model’s page."
msgstr "The server does not say how much context this model has. Type it from the model’s page."

#. Whether the model reasons before it answers.
#: src/renderer/src/agents/OwnModelServers.tsx
msgid "Thinking"
msgstr "Thinking"

#. {model} is a model name.
#: src/renderer/src/agents/OwnModelServers.tsx
msgid "Thinking for {model}"
msgstr "Thinking for {model}"

#: src/renderer/src/agents/ownServerTurnWords.ts
msgid "This thread is too long for {model}."
msgstr "This thread is too long for {model}."

#: src/renderer/src/agents/ownServerWords.ts
msgid "Threads on this server send your code and messages to it, so whoever runs it can read them."
msgstr "Threads on this server send your code and messages to it, so whoever runs it can read them."

#. Button under a failed turn: sends the user’s last message again.
#: src/renderer/src/agents/OwnModelServers.tsx
#: src/renderer/src/agents/ownServerTurnWords.ts
msgid "Try again"
msgstr "Try again"

#: src/renderer/src/agents/ownServerTurnWords.ts
msgid "Try again, sending your last message to {name} again"
msgstr "Try again, sending your last message to {name} again"

#. 128K means 128 times 1,024 tokens; keep 131072 and 128K as they are.
#: src/renderer/src/agents/ownServerWords.ts
msgid "Type a number of tokens from {min} to {max}, such as 131072 or 128K."
msgstr "Type a number of tokens from {min} to {max}, such as 131072 or 128K."

#: src/renderer/src/agents/OwnModelServers.tsx
msgid "What the model menu calls it."
msgstr "What the model menu calls it."

#: src/renderer/src/agents/OwnModelServers.tsx
msgid "Where the server listens, on this computer, your network or your tailnet."
msgstr "Where the server listens, on this computer, your network or your tailnet."

#: src/renderer/src/agents/ownServerTurnWords.ts
msgid "Your last message and the thread before it are more than the model takes at once. Nothing in the thread was lost. OpenCode threads can’t be compacted in Sotto, so pick a model with more context and try again, or start a new thread."
msgstr "Your last message and the thread before it are more than the model takes at once. Nothing in the thread was lost. OpenCode threads can’t be compacted in Sotto, so pick a model with more context and try again, or start a new thread."

#: src/renderer/src/agents/OwnModelServers.tsx
msgid "Your own model servers"
msgstr "Your own model servers"

#: src/renderer/src/agents/OwnModelServers.tsx
msgid "Your own server: add a model server you run"
msgstr "Your own server: add a model server you run"

#: src/renderer/src/agents/OwnModelServers.tsx
msgid "Your own server…"
msgstr "Your own server…"

#: src/renderer/src/agents/ownServerWords.ts
msgid "Your own servers run with OpenCode, and Sotto’s OpenCode is not running, so nothing was saved. Connect OpenCode under Providers, then add the server again."
msgstr "Your own servers run with OpenCode, and Sotto’s OpenCode is not running, so nothing was saved. Connect OpenCode under Providers, then add the server again."
