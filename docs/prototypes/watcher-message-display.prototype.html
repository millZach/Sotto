<!doctype html><html lang="en"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Watcher message display — prototype</title>
<style>:root{color-scheme:dark;--tt-bg:#06090e;--tt-surface:#141a23;--tt-text:#eef3fb;--tt-muted:#a8b3c2;--tt-line:#334050;--tt-accent:#71c3bb}*{box-sizing:border-box}body{margin:0;background:var(--tt-bg);color:var(--tt-text);font:16px Figtree,system-ui,sans-serif}main{max-width:1100px;margin:auto;padding:32px 24px 80px}h1{font-size:28px;margin:0 0 8px}p{line-height:1.6}.intro{color:var(--tt-muted);max-width:70ch}nav{display:flex;gap:8px;flex-wrap:wrap;margin:24px 0}button{background:transparent;border:1px solid var(--tt-line);color:var(--tt-text);border-radius:8px;padding:10px 14px;cursor:pointer}button[aria-selected=true]{border-color:var(--tt-accent);color:var(--tt-accent)}button:focus-visible{outline:3px solid var(--tt-accent)}.room{min-height:260px;border:1px solid var(--tt-line);border-radius:14px;padding:24px}.room>header{font-size:20px;margin-bottom:28px}.bubble{background:var(--tt-surface);border:1px solid var(--tt-line);border-radius:14px;padding:18px 22px;white-space:pre-wrap;overflow-wrap:anywhere}.who{color:var(--tt-muted);font-size:14px;margin-bottom:12px}.reply{margin:28px 12px}.state{margin-top:22px;border-top:1px solid var(--tt-line);padding-top:18px}dl{display:grid;grid-template-columns:180px 1fr;gap:12px}dt{color:var(--tt-muted)}dd{margin:0;overflow-wrap:anywhere}pre{white-space:pre-wrap;overflow-wrap:anywhere;font:14px ui-monospace,monospace;color:var(--tt-muted)}.note{color:var(--tt-muted);font-size:14px}@media(max-width:650px){main{padding:22px 16px}.room{padding:16px}dl{grid-template-columns:1fr;gap:6px}}
</style><main><h1>Watcher messages</h1><p class="intro">Prototype: show what you wrote while keeping Sotto’s routing context in the native request. Try an owned message, text that only looks like routing context, and a message changed outside Sotto.</p>
<nav role="tablist" aria-label="Message scenarios"><button role="tab" data-case="owned">Sent in Sotto</button><button role="tab" data-case="literal">Text you typed</button><button role="tab" data-case="edited">Changed outside Sotto</button><button role="tab" data-case="restored">Saved and reopened</button><button role="tab" data-case="legacy">Older saved message</button></nav>
<section class="room" aria-label="Watcher conversation preview"><header>Watcher</header><div class="bubble"><div class="who">You · 3:08 pm</div><div id="display"></div></div><div class="reply">Watcher here. I will look at the release notes.</div></section>
<section class="state"><h2>Prototype state</h2><p id="why"></p><dl><dt>Owned message</dt><dd id="owned"></dd><dt>Saved boundary</dt><dd id="boundary"></dd><dt>Exact native text</dt><dd id="match"></dd><dt>Native request changed</dt><dd>No. Displaying a message grants no permission.</dd></dl><details><summary>Example native request</summary><pre id="wire"></pre></details></section><p class="note">Zach selected “Original message only.” This is a throwaway, in-memory demo; it sends and saves nothing. Older desktop messages without a saved boundary retain their native text here. The phone’s existing old-message matcher is a separate compatibility choice.</p></main>
<script>
const authored='Check the release notes and tell me what is missing.';
const footer='\n\n[Sotto Watcher request: example-request. Local host: example-host. Use this requestId for sotto_threads mutations. Call list_projects for choices.]';
const digest=async text=>Array.from(new Uint8Array(await crypto.subtle.digest('SHA-256',new TextEncoder().encode(text))),b=>b.toString(16).padStart(2,'0')).join('');
async function project(state){const matches=!!state.proof&&await digest(state.wire)===state.proof.wireDigest;return{matches,text:state.owned&&matches?state.wire.slice(0,state.proof.originalLength):state.wire};}
async function scenario(name){const wire=authored+footer,proof={originalLength:authored.length,wireDigest:await digest(wire)};const states={owned:{owned:true,wire,proof,why:'The saved message and exact native text agree. Show the original instruction.'},literal:{owned:false,wire:authored+footer,why:'No Sotto-owned boundary. Preserve every word, even when it looks like routing context.'},edited:{owned:true,wire:wire+'\nA later edit made outside Sotto.',proof,why:'The native text changed. Preserve it rather than guessing where the author’s words end.'},restored:{owned:true,wire,proof:JSON.parse(JSON.stringify(proof)),why:'The length and digest survive reopening. No prompt text is stored in this display metadata.'},legacy:{owned:true,wire,why:'This old message has no saved boundary. Preserving its text is the conservative desktop behavior.'}};return states[name]||states.owned;}
let sequence=0;async function show(name){const token=++sequence,state=await scenario(name),view=await project(state);if(token!==sequence)return;document.querySelectorAll('[data-case]').forEach(b=>b.setAttribute('aria-selected',String(b.dataset.case===name)));document.getElementById('display').textContent=view.text;document.getElementById('wire').textContent=state.wire;document.getElementById('why').textContent=state.why;document.getElementById('owned').textContent=state.owned?'Yes':'No';document.getElementById('boundary').textContent=state.proof?'Original length '+state.proof.originalLength+'; SHA-256 of the complete native text':'None';document.getElementById('match').textContent=state.proof?(view.matches?'Matches':'Changed'):'Unverified';history.replaceState(null,'','?case='+name);}
document.querySelectorAll('[data-case]').forEach(b=>b.onclick=()=>show(b.dataset.case));show(new URLSearchParams(location.search).get('case')||'owned');
</script></html>
