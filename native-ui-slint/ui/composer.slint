// The composer: text with inline pills, chips under it and one round send button.
//
// Slint's TextInput cannot hold a widget inside its text, so a pill is its label in the text,
// bounded by two invisible markers (U+2064 or U+2063), with a rounded rectangle drawn behind it.
// Rust finds the pills, and a hidden twin TextInput with the same text and width measures where
// each one starts and ends (its cursor-position-changed callback reports the caret's position).
// Rust also makes each pill act as one character: Backspace removes all of it, and the arrow
// keys step over it.
import { Theme } from "generated/theme.slint";
import { Motion, Fonts, Icons, Icon, Chip, ChipMenu, MenuItem, FocusRing } from "base.slint";

export struct PillRect { x: length, y: length, width: length, kind: int }
export struct KeyAction { handled: bool, anchor: int, cursor: int, accept: bool }

component SendButton inherits Rectangle {
    in property <bool> busy;
    in property <bool> can-send;
    callback clicked();
    forward-focus: fs;
    width: 32px;
    height: 32px;
    border-radius: 16px;
    background: root.busy || root.can-send ? Theme.pill : Theme.surface-overlay;
    animate background { duration: Motion.d(120ms); }
    accessible-role: button;
    accessible-label: root.busy ? "Stop the reply" : "Send";
    accessible-enabled: root.busy || root.can-send;
    accessible-action-default => { root.clicked(); }
    Icon {
        path: root.busy ? Icons.stop : Icons.arrow-up;
        ink: root.busy || root.can-send ? Theme.pill-ink : Theme.text-quiet;
        size: root.busy ? 14px : 16px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
    TouchArea { clicked => { root.clicked(); } }
    fs := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " { root.clicked(); return accept; }
            reject
        }
    }
    FocusRing { width: parent.width + 6px; height: parent.height + 6px; shown: fs.has-focus; radius: 16px; }
}

// The editable text, its pills and the twin that measures them.
component PillEditor inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <[PillRect]> pills;
    in property <bool> rtl;
    in property <length> font-size: Theme.type-reading;
    in property <string> placeholder: "Write a follow-up";
    in property <length> max-visible-height: 200px;
    out property <length> line-height: input.font-metrics.ascent - input.font-metrics.descent;
    out property <bool> has-focus: input.has-focus;
    out property <int> cursor: input.cursor-position-byte-offset;
    out property <int> anchor: input.anchor-position-byte-offset;
    out property <length> content-width: input.width;
    callback edited(string);
    callback pill-key(string, bool, int, int) -> KeyAction;
    callback submit();
    callback caret-moved(int, int);
    callback composition-changed(string);
    property <Point> measured;
    public function measure-at(offset: int) -> Point {
        twin.set-selection-offsets(offset, offset);
        return root.measured;
    }
    public function take-focus() { input.focus(); }
    public function place-cursor(anchor: int, cursor: int) { input.set-selection-offsets(anchor, cursor); }
    preferred-height: Math.min(root.max-visible-height, input.preferred-height);
    min-height: root.line-height;
    forward-focus: input;

    fl := Flickable {
        width: parent.width;
        height: parent.height;
        content-height: Math.max(self.height, input.preferred-height);
        // Pills sit behind the text, at the positions the twin reports.
        for p in root.pills: Rectangle {
            x: p.x - 3px;
            y: p.y - 1px;
            width: p.width + 6px;
            height: root.line-height + 2px;
            border-radius: Theme.radius-tag;
            background: p.kind == 0 ? Theme.accent-surface : Theme.surface-overlay;
            border-width: 1px;
            border-color: p.kind == 0 ? Theme.accent-wash : Theme.field-border;
            Icon {
                path: p.kind == 0 ? Icons.paperclip : Icons.quote;
                ink: p.kind == 0 ? Theme.accent-surface-text : Theme.text-quiet;
                size: 12px;
                x: 5px;
                y: (parent.height - self.height) / 2;
            }
        }
        twin := TextInput {
            width: parent.width;
            text: input.text;
            font-size: root.font-size;
            wrap: word-wrap;
            single-line: false;
            read-only: true;
            enabled: false;
            opacity: 0;
            horizontal-alignment: root.rtl ? right : left;
            accessible-role: none;
            cursor-position-changed(p) => { root.measured = p; }
        }
        input := TextInput {
            width: parent.width;
            font-size: root.font-size;
            color: Theme.text;
            wrap: word-wrap;
            single-line: false;
            horizontal-alignment: root.rtl ? right : left;
            selection-background-color: Theme.accent-surface;
            selection-foreground-color: Theme.accent-surface-text;
            text-cursor-width: 2px;
            accessible-role: text-input;
            accessible-label: "Message";
            accessible-placeholder-text: root.placeholder;
            edited => { root.edited(self.text); }
            changed preedit-text => { root.composition-changed(self.preedit-text); }
            cursor-position-changed(p) => {
                // Keep the caret in view as the text grows past the visible height.
                if p.y + fl.content-y < 0 { fl.content-y = -p.y; }
                if p.y + root.line-height + fl.content-y > fl.height { fl.content-y = fl.height - p.y - root.line-height; }
                root.caret-moved(self.anchor-position-byte-offset, self.cursor-position-byte-offset);
            }
            key-pressed(event) => {
                if event.text == Key.Return && !event.modifiers.shift && self.preedit-text == "" { root.submit(); return accept; }
                if event.text == Key.Backspace || event.text == Key.Delete || event.text == Key.LeftArrow || event.text == Key.RightArrow {
                    let action = root.pill-key(event.text, event.modifiers.shift, self.anchor-position-byte-offset, self.cursor-position-byte-offset);
                    if action.handled {
                        self.set-selection-offsets(action.anchor, action.cursor);
                        return action.accept ? accept : reject;
                    }
                }
                reject
            }
        }
        if input.text == "" && input.preedit-text == "": Text {
            width: parent.width;
            text: root.placeholder;
            color: Theme.text-hint;
            font-size: root.font-size;
            horizontal-alignment: root.rtl ? right : left;
            accessible-role: none;
        }
    }
}

export component Composer inherits Rectangle {
    // 0: the card (as in the baseline), 1: the floating two-row card, 2: the slim bar.
    in property <int> variant: 0;
    in-out property <string> text <=> editor.text;
    in property <[PillRect]> pills;
    in property <bool> rtl;
    in property <bool> busy;
    in property <string> model-name: "Opus 5.5";
    in property <string> effort: "High";
    in property <string> permission: "Ask before edits";
    in property <[MenuItem]> models;
    in property <[MenuItem]> efforts;
    in property <[MenuItem]> permissions;
    in property <int> model-index;
    in property <int> effort-index;
    in property <int> permission-index;
    in property <string> status;
    out property <bool> editor-focused: editor.has-focus;
    out property <length> editor-width: editor.content-width;
    out property <length> line-height: editor.line-height;
    callback edited(string);
    callback pill-key(string, bool, int, int) -> KeyAction;
    callback caret-moved(int, int);
    callback composition-changed(string);
    callback send();
    callback attach();
    callback pick-model(int);
    callback pick-effort(int);
    callback pick-permission(int);
    callback layout-changed();
    public function measure-at(offset: int) -> Point { return editor.measure-at(offset); }
    public function take-focus() { editor.take-focus(); }
    public function place-cursor(anchor: int, cursor: int) { editor.place-cursor(anchor, cursor); }
    changed editor-width => { root.layout-changed(); }
    forward-focus: editor;
    accessible-role: form;
    accessible-label: "Composer";

    property <bool> can-send: editor.text != "";
    property <length> radius: root.variant == 1 ? Theme.radius-overlay : root.variant == 2 ? 22px : Theme.radius-card;
    property <length> pad-l: root.variant == 2 ? 18px : 16px;
    property <length> pad-r: root.variant == 2 ? 6px + 32px + 10px : 12px;
    property <length> pad-t: root.variant == 2 ? 11px : 14px;
    property <length> pad-b: root.variant == 2 ? 11px : root.variant == 1 ? 10px + 32px + 6px : 6px;

    model-menu := ChipMenu {
        title: "Model";
        items: root.models;
        current: root.model-index;
        x: model-chip.x + chips.x;
        y: chips.y - self.height - 6px;
        picked(i) => { root.pick-model(i); }
        dismissed => { model-chip.take-focus(); }
    }
    effort-menu := ChipMenu {
        title: "Effort";
        items: root.efforts;
        current: root.effort-index;
        x: Math.min(effort-chip.x + chips.x, root.width - self.width);
        y: chips.y - self.height - 6px;
        picked(i) => { root.pick-effort(i); }
        dismissed => { effort-chip.take-focus(); }
    }
    permission-menu := ChipMenu {
        title: "Permissions";
        items: root.permissions;
        current: root.permission-index;
        x: permission-chip.x + chips.x;
        y: chips.y - self.height - 6px;
        picked(i) => { root.pick-permission(i); }
        dismissed => { permission-chip.take-focus(); }
    }

    // The card's surface. In the baseline card it holds the chips too; the other two keep them outside.
    Rectangle {
        // A sized child of a plain element is centred by default: pin it to the top.
        x: 0;
        y: 0;
        width: root.width;
        height: root.variant == 0 ? root.height : area.height;
        background: root.variant == 2 ? Theme.surface-elevated : Theme.composer-card;
        border-radius: root.radius;
        border-width: root.variant == 1 ? 1px : editor.has-focus && root.variant == 2 ? 1px : 0px;
        border-color: root.variant == 1 ? Theme.border-faint : Theme.field-border-focus;
        drop-shadow-blur: root.variant == 1 ? 28px : 0px;
        drop-shadow-offset-y: root.variant == 1 ? 10px : 0px;
        drop-shadow-color: root.variant == 1 ? (Theme.dark ? #00000066 : #2018101f) : transparent;
    }

    VerticalLayout {
        spacing: root.variant == 0 ? 0px : 6px;
        area := Rectangle {
            height: editor.preferred-height + root.pad-t + root.pad-b;
            editor := PillEditor {
                x: root.pad-l;
                y: root.pad-t;
                width: parent.width - root.pad-l - root.pad-r;
                height: self.preferred-height;
                pills: root.pills;
                rtl: root.rtl;
                placeholder: root.busy ? "Write a follow-up to queue it" : "Write a follow-up";
                edited(t) => { root.edited(t); }
                pill-key(k, s, a, c) => { return root.pill-key(k, s, a, c); }
                caret-moved(a, c) => { root.caret-moved(a, c); }
                composition-changed(t) => { root.composition-changed(t); }
                submit => { root.send(); }
            }
            if root.variant == 1: SendButton { x: parent.width - 12px - 32px; y: parent.height - 10px - 32px; busy: root.busy; can-send: root.can-send; clicked => { root.send(); } }
            if root.variant == 2: SendButton { x: parent.width - 6px - 32px; y: (parent.height - 32px) / 2; busy: root.busy; can-send: root.can-send; clicked => { root.send(); } }
        }
        chips := HorizontalLayout {
            padding-left: root.variant == 0 ? 10px : 8px;
            padding-right: root.variant == 0 ? 10px : 8px;
            padding-bottom: root.variant == 0 ? 10px : 0px;
            spacing: 4px;
            attach-chip := Chip { menu: false; accessible-role: button; icon: Icons.paperclip; label: root.variant == 0 ? "" : "Attach"; name: "Attach a file"; outlined: root.variant == 1; clicked => { root.attach(); } }
            permission-chip := Chip { icon: Icons.shield; label: root.permission; name: "Permissions"; outlined: root.variant == 1; clicked => { permission-menu.show(); } }
            Rectangle { horizontal-stretch: 1; }
            if root.variant != 0: Text { text: root.status; color: Theme.text-quiet; font-size: Theme.type-caption; vertical-alignment: center; accessible-role: none; }
            model-chip := Chip { icon: Icons.spark; label: root.model-name; name: "Model"; outlined: root.variant == 1; clicked => { model-menu.show(); } }
            effort-chip := Chip { icon: Icons.gauge; label: root.effort; name: "Effort"; outlined: root.variant == 1; clicked => { effort-menu.show(); } }
            if root.variant == 0: SendButton { busy: root.busy; can-send: root.can-send; clicked => { root.send(); } }
        }
    }
}
