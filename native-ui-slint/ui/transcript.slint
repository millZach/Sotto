// The transcript: one virtualised list of rows, each a block of a message.
import { ListView } from "std-widgets.slint";
import { Theme } from "generated/theme.slint";
import { Motion, Fonts, Icons, Icon, QuietButton, FocusRing } from "base.slint";

export struct DiffLine { kind: int, old-no: string, new-no: string }
export struct TableRow { cells: [styled-text] }

// kind: 0 author line, 1 your message, 2 prose (paragraphs and lists), 3 heading, 4 code block,
//       5 table, 6 diff, 7 activity (a folded tool call), 8 "Writing a reply" line
export struct Row {
    kind: int,
    author: string,
    time: string,
    you: bool,
    text: styled-text,
    plain: string,
    level: int,
    lang: string,
    detail: string,
    expanded: bool,
    lines: int,
    diff: [DiffLine],
    columns: [float],
    header: [styled-text],
    rows: [TableRow],
    rtl: bool,
    selected: bool,
    label: string,
}

// The width prose runs to: about 42em of the reading size, as rich-messages.css sets it.
global Measure {
    out property <length> prose: 42 * 16px;
    // The same 760px column the composer takes (threads.css, the transcript and the compose padding).
    out property <length> column: 760px;
}

component AuthorLine inherits HorizontalLayout {
    in property <Row> item;
    alignment: item.you ? end : start;
    spacing: 8px;
    padding-top: 18px;
    padding-bottom: 6px;
    Text {
        text: item.author;
        font-size: Theme.type-caption;
        font-weight: 600;
        color: Theme.transcript-muted;
        accessible-role: none;
    }
    Text {
        text: item.time;
        font-size: Theme.type-caption;
        color: Theme.transcript-muted;
        accessible-role: none;
    }
}

component Bubble inherits HorizontalLayout {
    in property <Row> item;
    in property <length> avail;
    callback link(string);
    alignment: end;
    Rectangle {
        background: Theme.bubble;
        border-radius: Theme.radius-card;
        max-width: root.avail * 0.82;
        accessible-role: text;
        accessible-label: "You said: " + item.plain;
        HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 11px;
            padding-bottom: 11px;
            StyledText {
                text: item.text;
                selectable: true;
                default-color: Theme.reading-bubble-text;
                default-font-size: Theme.type-lead;
                link-color: Theme.link;
                horizontal-alignment: item.rtl ? right : left;
                selection-background-color: Theme.accent-surface;
                selection-foreground-color: Theme.accent-surface-text;
                link-clicked(url) => { root.link(url); }
            }
        }
    }
}

component Prose inherits HorizontalLayout {
    in property <Row> item;
    callback link(string);
    alignment: start;
    padding-top: 4px;
    padding-bottom: 8px;
    st := StyledText {
        max-width: Measure.prose;
        text: item.text;
        selectable: true;
        default-color: Theme.reading-text;
        default-font-size: Theme.type-lead;
        link-color: Theme.link;
        horizontal-alignment: item.rtl ? right : left;
        selection-background-color: Theme.accent-surface;
        selection-foreground-color: Theme.accent-surface-text;
        accessible-role: text;
        accessible-label: item.plain;
        link-clicked(url) => { root.link(url); }
    }
}

component Heading inherits HorizontalLayout {
    in property <Row> item;
    padding-top: item.level <= 2 ? 22px : 14px;
    padding-bottom: 6px;
    StyledText {
        max-width: Measure.prose;
        text: item.text;
        selectable: true;
        default-color: Theme.reading-text;
        default-font-size: item.level <= 2 ? Theme.type-heading : Theme.type-lead;
        selection-background-color: Theme.accent-surface;
        selection-foreground-color: Theme.accent-surface-text;
        // Slint has no heading role: the level is said in the name instead.
        accessible-role: text;
        accessible-label: "Heading level " + item.level + ": " + item.plain;
    }
}

// The head of a code block, a diff or an activity's output: a label and a Copy button.
component BlockHead inherits HorizontalLayout {
    in property <string> label;
    in property <string> detail;
    in property <string> copy-name;
    in property <bool> copied;
    callback copy();
    height: 34px;
    padding-left: 12px;
    padding-right: 4px;
    spacing: 8px;
    Text { text: root.label; color: Theme.text-quiet; font-size: Theme.type-caption; vertical-alignment: center; accessible-role: none; }
    Text { text: root.detail; color: Theme.text-quiet; font-size: Theme.type-caption; vertical-alignment: center; horizontal-stretch: 1; accessible-role: none; }
    QuietButton {
        icon: root.copied ? Icons.check : Icons.copy;
        label: root.copied ? "Copied" : "Copy";
        name: root.copy-name;
        icon-size: 14px;
        ink: Theme.text-quiet;
        clicked => { root.copy(); }
    }
}

component CodeBlock inherits Rectangle {
    in property <Row> item;
    in property <bool> copied;
    callback copy();
    background: Theme.code-bg;
    border-radius: Theme.radius-inset;
    border-width: 1px;
    border-color: Theme.reading-hairline;
    accessible-role: groupbox;
    accessible-label: (item.lang == "" ? "Code" : item.lang + " code") + ", " + item.lines + " lines";
    VerticalLayout {
        BlockHead { label: item.lang; copy-name: "Copy the " + item.lang + " code"; copied: root.copied; copy => { root.copy(); } }
        Rectangle { height: 1px; background: Theme.reading-hairline; }
        fl := Flickable {
            height: body.preferred-height + 20px;
            content-width: max(self.width, body.preferred-width + 28px);
            body := StyledText {
                x: 14px;
                y: 10px;
                text: item.text;
                selectable: true;
                default-font-family: Fonts.mono;
                default-font-size: Theme.type-small;
                default-color: Theme.reading-code-text;
                selection-background-color: Theme.accent-surface;
                selection-foreground-color: Theme.accent-surface-text;
                accessible-role: text;
                accessible-label: item.plain;
            }
        }
    }
}

component DiffBlock inherits Rectangle {
    in property <Row> item;
    in property <bool> copied;
    callback copy();
    property <length> line-h: item.lines > 0 ? body.preferred-height / item.lines : 18px;
    property <length> gutter: 76px;
    background: Theme.code-bg;
    border-radius: Theme.radius-inset;
    border-width: 1px;
    border-color: Theme.reading-hairline;
    clip: true;
    accessible-role: groupbox;
    accessible-label: "Changes to " + item.lang + ", " + item.detail;
    VerticalLayout {
        BlockHead { label: item.lang; detail: item.detail; copy-name: "Copy the diff"; copied: root.copied; copy => { root.copy(); } }
        Rectangle { height: 1px; background: Theme.reading-hairline; }
        Flickable {
            height: body.preferred-height + 12px;
            content-width: max(self.width, body.preferred-width + root.gutter + 24px);
            for line[i] in item.diff: Rectangle {
                y: 6px + i * root.line-h;
                height: root.line-h;
                width: parent.content-width;
                background: line.kind == 1 ? Theme.diff-added : line.kind == 2 ? Theme.diff-removed : line.kind == 3 ? Theme.surface-elevated : transparent;
                Rectangle {
                    x: 0;
                    width: 2px;
                    background: line.kind == 1 ? Theme.diff-edge-added : line.kind == 2 ? Theme.diff-edge-removed : transparent;
                }
                Text { x: 8px; width: 28px; text: line.old-no; horizontal-alignment: right; color: Theme.text-quiet; font-family: Fonts.mono; font-size: Theme.type-caption; vertical-alignment: center; accessible-role: none; }
                Text { x: 40px; width: 28px; text: line.new-no; horizontal-alignment: right; color: Theme.text-quiet; font-family: Fonts.mono; font-size: Theme.type-caption; vertical-alignment: center; accessible-role: none; }
            }
            body := StyledText {
                x: root.gutter;
                y: 6px;
                text: item.text;
                selectable: true;
                default-font-family: Fonts.mono;
                default-font-size: Theme.type-small;
                default-color: Theme.reading-code-text;
                selection-background-color: Theme.accent-surface;
                selection-foreground-color: Theme.accent-surface-text;
                accessible-role: text;
                accessible-label: item.plain;
            }
        }
    }
}

component TableBlock inherits Rectangle {
    in property <Row> item;
    border-radius: Theme.radius-inset;
    border-width: 1px;
    border-color: Theme.reading-hairline;
    clip: true;
    accessible-role: table;
    accessible-label: "Table, " + item.rows.length + " rows";
    VerticalLayout {
        Rectangle {
            background: Theme.surface-elevated;
            HorizontalLayout {
                padding: 10px;
                spacing: 14px;
                for cell[c] in item.header: StyledText {
                    horizontal-stretch: item.columns[c];
                    preferred-width: 1px;
                    min-width: 40px;
                    text: cell;
                    selectable: true;
                    default-font-size: Theme.type-body;
                    default-color: Theme.reading-text;
                    accessible-role: text;
                }
            }
        }
        for r[ri] in item.rows: Rectangle {
            background: Math.mod(ri, 2) == 1 ? Theme.table-stripe : transparent;
            border-width: 0;
            VerticalLayout {
                Rectangle { height: 1px; background: Theme.reading-hairline; }
                HorizontalLayout {
                    padding: 10px;
                    spacing: 14px;
                    for cell[c] in r.cells: StyledText {
                        horizontal-stretch: item.columns[c];
                        preferred-width: 1px;
                        min-width: 40px;
                        text: cell;
                        selectable: true;
                        default-font-size: Theme.type-body;
                        default-color: Theme.reading-text;
                        selection-background-color: Theme.accent-surface;
                        selection-foreground-color: Theme.accent-surface-text;
                        accessible-role: text;
                    }
                }
            }
        }
    }
}

// A folded tool call. Enter or Space opens and closes it.
component Activity inherits VerticalLayout {
    in property <Row> item;
    callback toggle();
    padding-top: 2px;
    padding-bottom: 2px;
    spacing: 4px;
    head := Rectangle {
        height: 30px;
        border-radius: Theme.radius-row;
        background: touch.has-hover ? Theme.hover : transparent;
        animate background { duration: Motion.d(120ms); }
        accessible-role: button;
        accessible-label: item.lang;
        accessible-description: item.detail;
        accessible-expandable: true;
        accessible-expanded: item.expanded;
        accessible-action-default => { root.toggle(); }
        accessible-action-expand => { root.toggle(); }
        HorizontalLayout {
            padding-left: 6px;
            padding-right: 8px;
            spacing: 8px;
            Icon {
                path: Icons.chevron-right;
                ink: Theme.transcript-muted;
                size: 14px;
                y: (parent.height - self.height) / 2;
                transform-rotation: item.expanded ? 90deg : 0deg;
                transform-origin: { x: self.width / 2, y: self.height / 2 };
                animate transform-rotation { duration: Motion.d(140ms); easing: ease-out; }
            }
            Text { text: item.lang; color: Theme.transcript-muted; font-size: Theme.type-small; vertical-alignment: center; overflow: elide; accessible-role: none; }
            Text { text: item.detail; color: Theme.text-quiet; font-size: Theme.type-caption; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; accessible-role: none; }
        }
        touch := TouchArea { clicked => { fs.focus(); root.toggle(); } }
        fs := FocusScope {
            key-pressed(event) => {
                if event.text == Key.Return || event.text == " " { root.toggle(); return accept; }
                if event.text == Key.RightArrow && !item.expanded { root.toggle(); return accept; }
                if (event.text == Key.LeftArrow || event.text == Key.Escape) && item.expanded { root.toggle(); return accept; }
                reject
            }
        }
        FocusRing { width: parent.width + 6px; height: parent.height + 6px; shown: fs.has-focus; radius: Theme.radius-row; }
    }
    if item.expanded: Rectangle {
        background: Theme.code-bg;
        border-radius: Theme.radius-inset;
        border-width: 1px;
        border-color: Theme.reading-hairline;
        clip: true;
        accessible-role: text;
        accessible-label: "Output of " + item.lang;
        Flickable {
            height: out.preferred-height + 20px;
            content-width: max(self.width, out.preferred-width + 28px);
            out := StyledText {
                x: 14px;
                y: 10px;
                text: item.text;
                selectable: true;
                default-font-family: Fonts.mono;
                default-font-size: Theme.type-caption;
                default-color: Theme.reading-code-text;
                selection-background-color: Theme.accent-surface;
                selection-foreground-color: Theme.accent-surface-text;
                accessible-role: text;
                accessible-label: item.plain;
            }
        }
    }
}

component Writing inherits HorizontalLayout {
    padding-top: 10px;
    padding-bottom: 6px;
    spacing: 8px;
    Rectangle {
        width: 8px;
        height: 8px;
        y: (parent.height - self.height) / 2;
        border-radius: 4px;
        background: Theme.accent;
        // A slow breath, held still under reduced motion.
        opacity: Motion.reduced ? 1 : 0.35 + 0.65 * Math.abs(Math.sin(animation-tick() / 1100ms * 180deg));
    }
    Text { text: "Writing a reply"; color: Theme.transcript-muted; font-size: Theme.type-small; vertical-alignment: center; accessible-role: none; }
}

export component Transcript inherits Rectangle {
    in property <[Row]> rows;
    in property <int> copied-row: -1;
    in-out property <bool> following: true;
    callback toggle-activity(int);
    callback copy-row(int);
    callback link(string);
    out property <bool> at-end: lv.content-y <= lv.visible-height - lv.content-height + 2px;
    out property <bool> has-focus: fs.has-focus;
    out property <length> visible-height: lv.visible-height;
    public function scroll-to-end() {
        lv.content-y = Math.min(0px, lv.visible-height - lv.content-height);
    }
    public function take-focus() { fs.focus(); }
    public function scroll-by(d: length) {
        root.following = false;
        lv.content-y = Math.min(0px, lv.content-y + d);
    }
    // The row a keyboard or screen reader user is on; Up and Down move it, Enter acts on it.
    in-out property <int> current: -1;
    forward-focus: fs;

    // Follow the stream until the reader scrolls away; the content's growth pulls the view along.
    changed rows => { if root.following { root.scroll-to-end(); } }

    function move-to(i: int) {
        root.current = Math.max(0, Math.min(root.rows.length - 1, i));
        root.following = root.current == root.rows.length - 1;
        lv.ensure-row-visible(root.current, ScrollBehavior.instant);
    }
    fs := FocusScope {
        accessible-role: list;
        accessible-label: "Transcript";
        accessible-delegate-focus: root.current;
        focus-gained(reason) => { if root.current < 0 || root.current >= root.rows.length { root.current = root.rows.length - 1; } }
        key-pressed(event) => {
            if event.text == Key.DownArrow { root.move-to(root.current + 1); return accept; }
            if event.text == Key.UpArrow { root.move-to(root.current - 1); return accept; }
            if event.text == Key.PageDown { lv.content-y = Math.max(lv.visible-height - lv.content-height, lv.content-y - lv.visible-height * 0.9); root.following = root.at-end; return accept; }
            if event.text == Key.PageUp { lv.content-y = Math.min(0px, lv.content-y + lv.visible-height * 0.9); root.following = false; return accept; }
            if event.text == Key.Home { root.move-to(0); return accept; }
            if event.text == Key.End { root.move-to(root.rows.length - 1); root.following = true; root.scroll-to-end(); return accept; }
            if event.text == Key.Return || event.text == " " {
                if root.rows[root.current].kind == 7 { root.toggle-activity(root.current); return accept; }
                if root.rows[root.current].kind == 4 || root.rows[root.current].kind == 6 { root.copy-row(root.current); return accept; }
            }
            reject
        }

    lv := ListView {
        accessible-role: none;
        scrolled => { root.following = root.at-end; }
        // Virtualised rows are estimated until they are built, so the end moves as they are: keep up with it.
        changed content-height => { if root.following { root.scroll-to-end(); } }
        changed visible-height => { if root.following { root.scroll-to-end(); } }
        for row[i] in root.rows: Rectangle {
            // Centre the reading column, as the thread pane does.
            property <length> column: Math.min(Measure.column, lv.visible-width - 48px);
            background: fs.has-focus && i == root.current ? Theme.accent-wash : transparent;
            accessible-role: list-item;
            accessible-label: row.label;
            accessible-item-index: i;
            accessible-item-count: root.rows.length;
            accessible-expandable: row.kind == 7;
            accessible-expanded: row.expanded;
            HorizontalLayout {
                padding-left: (lv.visible-width - parent.column) / 2;
                padding-right: (lv.visible-width - parent.column) / 2;
                padding-bottom: i == root.rows.length - 1 ? 24px : 0px;
                if row.kind == 0: AuthorLine { item: row; }
                if row.kind == 1: Bubble { item: row; avail: column; link(u) => { root.link(u); } }
                if row.kind == 2: Prose { item: row; link(u) => { root.link(u); } }
                if row.kind == 3: Heading { item: row; }
                if row.kind == 4: VerticalLayout { padding-top: 6px; padding-bottom: 10px; CodeBlock { item: row; copied: root.copied-row == i; copy => { root.copy-row(i); } } }
                if row.kind == 5: VerticalLayout { padding-top: 6px; padding-bottom: 10px; TableBlock { item: row; } }
                if row.kind == 6: VerticalLayout { padding-top: 6px; padding-bottom: 10px; DiffBlock { item: row; copied: root.copied-row == i; copy => { root.copy-row(i); } } }
                if row.kind == 7: Activity { item: row; toggle => { root.toggle-activity(i); } }
                if row.kind == 8: Writing { }
            }
        }
    }
    }
    FocusRing {
        x: 1px;
        y: 1px;
        width: parent.width - 2px;
        height: parent.height - 2px;
        shown: fs.has-focus;
        radius: Theme.radius-inset;
    }
}
