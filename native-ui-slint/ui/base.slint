// Shared pieces: motion, fonts, icons and the small controls every surface uses.
import { Theme } from "generated/theme.slint";

// Reduced motion, read from the system by Rust (org.gnome.desktop.interface enable-animations).
export global Motion {
    in-out property <bool> reduced: false;
    // A duration that collapses to nothing when motion is reduced.
    public pure function d(ms: duration) -> duration { return self.reduced ? 0ms : ms; }
}

export global Fonts {
    in-out property <string> ui: "Figtree";
    in-out property <string> mono: "JetBrainsMono Nerd Font";
}

// Icon paths from Lucide (ISC), drawn on a 24-unit grid, the set Sotto already ships.
export global Icons {
    out property <string> paperclip: "M21.44 11.05 12.25 20.24 A6 6 0 0 1 3.76 11.75 L12.33 3.18 A4 4 0 1 1 18 8.84 L9.41 17.41 A2 2 0 0 1 6.58 14.58 L15.07 6.1";
    out property <string> chevron-right: "M9 18 L15 12 L9 6";
    out property <string> chevron-down: "M6 9 L12 15 L18 9";
    out property <string> arrow-up: "M5 12 L12 5 L19 12 M12 19 L12 5";
    out property <string> arrow-down: "M12 5 L12 19 M19 12 L12 19 L5 12";
    out property <string> close: "M18 6 L6 18 M6 6 L18 18";
    out property <string> minimise: "M5 12 L19 12";
    out property <string> maximise: "M5 5 L19 5 L19 19 L5 19 Z";
    out property <string> copy: "M9 9 L21 9 L21 21 L9 21 Z M5 15 L3 15 L3 3 L15 3 L15 5";
    out property <string> check: "M20 6 L9 17 L4 12";
    out property <string> moon: "M12 3 A6 6 0 0 0 21 12 A9 9 0 1 1 12 3 Z";
    out property <string> sun: "M12 8 A4 4 0 1 0 12.01 8 Z M12 2 L12 4 M12 20 L12 22 M4.93 4.93 L6.34 6.34 M17.66 17.66 L19.07 19.07 M2 12 L4 12 M20 12 L22 12 M6.34 17.66 L4.93 19.07 M19.07 4.93 L17.66 6.34";
    out property <string> terminal: "M4 17 L10 11 L4 5 M12 19 L20 19";
    out property <string> globe: "M12 2 A10 10 0 1 0 12.01 2 Z M2 12 L22 12 M12 2 A15 15 0 0 1 12 22 A15 15 0 0 1 12 2 Z";
    out property <string> shield: "M20 13 C20 18 16.5 20.5 12.34 21.95 A1 1 0 0 1 11.67 21.94 C7.5 20.5 4 18 4 13 L4 6 A1 1 0 0 1 5 5 C7 5 9.5 3.8 11.24 2.28 A1.17 1.17 0 0 1 12.76 2.28 C14.51 3.81 17 5 19 5 A1 1 0 0 1 20 6 Z";
    out property <string> quote: "M6 8 L10 8 L10 12 C10 15 8.5 16.5 6 17 M14 8 L18 8 L18 12 C18 15 16.5 16.5 14 17";
