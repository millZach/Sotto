export component Icon inherits Path {
    in property <string> path;
    in property <color> ink: Theme.text;
    in property <length> size: 16px;
    commands: self.path;
    viewbox-width: 24;
    viewbox-height: 24;
    width: self.size;
    height: self.size;
    stroke: self.ink;
    stroke-width: 1.75px;
    fill: transparent;
    accessible-role: none;
}

// The focus ring: two pixels of the theme's focus colour just outside the control.
export component FocusRing inherits Rectangle {
    in property <bool> shown;
    in property <length> radius: Theme.radius-control;
    x: -3px;
    y: -3px;
    border-radius: self.radius + 3px;
    border-width: self.shown ? 2px : 0px;
    border-color: Theme.focus-ring;
    background: transparent;
}

// A quiet button: icon, text or both. Its accessible name says what a press does.
export component QuietButton inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    in property <string> name: self.label;
    in property <bool> show-label: true;
    in property <length> icon-size: 16px;
    in property <color> ink: Theme.text-2;
    in property <length> pad: 8px;
    in property <bool> pressed-look;
    callback clicked();
    forward-focus: fs;
    accessible-role: button;
    accessible-label: root.name;
    accessible-action-default => { root.clicked(); }
    border-radius: Theme.radius-row;
    background: touch.has-hover || root.pressed-look ? Theme.hover : transparent;
    animate background { duration: Motion.d(120ms); }
    min-height: 28px;
    min-width: 28px;
    HorizontalLayout {
        padding-left: root.pad;
        padding-right: root.pad;
        spacing: 6px;
        alignment: center;
        if root.icon != "": Icon { path: root.icon; ink: root.ink; size: root.icon-size; y: (parent.height - self.height) / 2; }
        if root.show-label && root.label != "": Text {
            text: root.label;
            color: root.ink;
            font-size: Theme.type-small;
            vertical-alignment: center;
            accessible-role: none;
        }
    }
    touch := TouchArea { clicked => { fs.focus(); root.clicked(); } }
    fs := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " { root.clicked(); return accept; }
            reject
        }
    }
    FocusRing { width: parent.width + 6px; height: parent.height + 6px; shown: fs.has-focus; radius: root.border-radius; }
}

// A chip under the composer that opens a menu.
export component Chip inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <string> name;
    in property <color> ink: Theme.text-quiet;
    in property <bool> outlined: false;
    // A chip that opens a menu says its current value with its name; Attach is a plain button.
    in property <bool> menu: true;
    callback clicked();
    out property <bool> has-focus: fs.has-focus;
    public function take-focus() { fs.focus(); }
    forward-focus: fs;
    horizontal-stretch: 0;
    accessible-role: combobox;
    accessible-label: root.menu ? root.name + ", " + root.label : root.name;
    accessible-value: root.menu ? root.label : "";
    accessible-action-default => { root.clicked(); }
    accessible-expandable: root.menu;
    height: 28px;
    border-radius: Theme.radius-control;
    border-width: root.outlined ? 1px : 0px;
    border-color: Theme.field-border;
    background: touch.has-hover ? Theme.hover : transparent;
    animate background { duration: Motion.d(120ms); }
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 6px;
        if root.icon != "": Icon { path: root.icon; ink: root.ink; size: 14px; y: (parent.height - self.height) / 2; }
        // Elided rather than overflowing, so the row fits a narrow window.
        Text { text: root.label; color: root.ink; font-size: Theme.type-small; vertical-alignment: center; overflow: elide; min-width: 0; accessible-role: none; }
    }
    touch := TouchArea { clicked => { fs.focus(); root.clicked(); } }
    fs := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " || event.text == Key.DownArrow { root.clicked(); return accept; }
            reject
        }
    }
    FocusRing { width: parent.width + 6px; height: parent.height + 6px; shown: fs.has-focus; radius: root.border-radius; }
}

export struct MenuItem { label: string, detail: string }

// A menu opened from a chip. Up and Down move, Enter picks, Escape closes and gives the focus back.
export component ChipMenu inherits PopupWindow {
    in property <[MenuItem]> items;
    in property <int> current;
    in property <string> title;
    callback picked(int);
    callback dismissed();
    property <int> hover: root.current;
    close-policy: close-on-click-outside;
    width: 240px;
    Rectangle {
        background: Theme.surface-overlay;
        border-radius: Theme.radius-inset;
        border-width: 1px;
        border-color: Theme.border-faint;
        drop-shadow-blur: 24px;
        drop-shadow-color: #0000004d;
        drop-shadow-offset-y: 8px;
        fs := FocusScope {
            accessible-role: list;
            accessible-label: root.title;
            accessible-delegate-focus: root.hover;
            init => { self.focus(); }
            key-pressed(event) => {
                if event.text == Key.Escape { root.close(); root.dismissed(); return accept; }
                if event.text == Key.DownArrow { root.hover = Math.min(root.items.length - 1, root.hover + 1); return accept; }
                if event.text == Key.UpArrow { root.hover = Math.max(0, root.hover - 1); return accept; }
                if event.text == Key.Return || event.text == " " { root.picked(root.hover); root.close(); root.dismissed(); return accept; }
                if event.text == Key.Tab || event.text == Key.Backtab { root.close(); root.dismissed(); return accept; }
                reject
            }
            VerticalLayout {
                padding: 6px;
                spacing: 2px;
                HorizontalLayout { padding-left: 8px; Text { text: root.title; color: Theme.text-quiet; font-size: Theme.type-caption; height: 22px; vertical-alignment: center; accessible-role: none; } }
                for item[i] in root.items: Rectangle {
                    height: 34px;
                    border-radius: Theme.radius-row;
                    background: i == root.hover ? Theme.hover : transparent;
                    accessible-role: list-item;
                    accessible-label: item.label;
                    accessible-description: item.detail;
                    accessible-item-selectable: true;
                    accessible-item-selected: i == root.current;
                    accessible-item-index: i;
                    accessible-item-count: root.items.length;
                    accessible-action-default => { root.picked(i); root.close(); root.dismissed(); }
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;
                        Text { text: item.label; color: Theme.text; font-size: Theme.type-small; vertical-alignment: center; horizontal-stretch: 1; accessible-role: none; }
                        Text { text: item.detail; color: Theme.text-quiet; font-size: Theme.type-caption; vertical-alignment: center; accessible-role: none; }
                        if i == root.current: Icon { path: Icons.check; ink: Theme.accent-text; size: 14px; y: (parent.height - self.height) / 2; }
                    }
                    TouchArea {
                        moved => { root.hover = i; }
                        clicked => { root.picked(i); root.close(); root.dismissed(); }
                    }
                }
            }
        }
    }
}
