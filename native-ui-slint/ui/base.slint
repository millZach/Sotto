// Shared pieces: motion, fonts, icons and the small controls every surface uses.
import { Theme } from "generated/theme.slint";

// Reduced motion, read from the system by Rust (org.gnome.desktop.interface enable-animations).
export global Motion {
    in-out property <bool> reduced: false;
    // A duration that collapses to nothing when motion is reduced.
    public pure function d(ms: duration) -> duration { return self.reduced ? 0ms : ms; }
}

export global Fonts {
    in-out property <string> ui: "Figtree";
    in-out property <string> mono: "JetBrainsMono Nerd Font";
}

