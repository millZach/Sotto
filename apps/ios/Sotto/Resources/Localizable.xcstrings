        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ पर्यंत पोहोचता येत नाही, त्यामुळे पुल रिक्वेस्ट वाचली नाही. पुन्हा कनेक्ट करा आणि पुन्हा प्रयत्न करा."
