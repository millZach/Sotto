    "Watcher starts nothing new until one of these finishes or stops. A thread waiting on you still counts." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يبدأ Watcher شيئًا جديدًا حتى تنتهي إحدى هذه المحادثات أو تتوقف. المحادثة التي تنتظرك تُحتسب أيضًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এগুলোর একটি শেষ না হওয়া বা না থামা পর্যন্ত Watcher নতুন কিছু শুরু করে না। আপনার অপেক্ষায় থাকা থ্রেডও গোনা হয়।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher nezačne nic nového, dokud jedno z nich neskončí nebo se nezastaví. Vlákno, které čeká na vás, se také počítá."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher starter ikke noget nyt, før en af disse bliver færdig eller stopper. En tråd, der venter på dig, tæller stadig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher startet nichts Neues, bis einer davon fertig ist oder stoppt. Ein Thread, der auf dich wartet, zählt mit."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο Watcher δεν ξεκινά τίποτα νέο μέχρι να ολοκληρωθεί ή να σταματήσει ένα από αυτά. Ένα νήμα που σας περιμένει μετράει κι αυτό."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher starts nothing new until one of these finishes or stops. A thread waiting on you still counts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher no inicia nada nuevo hasta que uno de estos termine o se detenga. Un hilo que te está esperando también cuenta."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher no inicia nada nuevo hasta que uno de estos termine o se detenga. Un hilo que te está esperando también cuenta."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher no inicia nada nuevo hasta que uno de estos termine o se detenga. Un hilo que te está esperando también cuenta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher ei aloita mitään uutta ennen kuin jokin näistä valmistuu tai pysähtyy. Sinua odottava ketju lasketaan silti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher ne démarre rien de nouveau tant que l’un d’eux n’est pas terminé ou arrêté. Un fil qui vous attend compte toujours."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इनमें से किसी एक के पूरा होने या रुकने तक Watcher कुछ नया शुरू नहीं करता। आपका इंतज़ार कर रहा थ्रेड भी गिना जाता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Watcher nem indít újat, amíg ezek közül egy be nem fejeződik vagy le nem áll. A rád váró szál is beleszámít."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher non avvia nulla di nuovo finché uno di questi non termina o si ferma. Un thread che ti aspetta conta comunque."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらのいずれかが完了または停止するまで、Watcher は新しいスレッドを開始しません。あなたの対応を待っているスレッドも数に含まれます。"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यापैकी एखादा पूर्ण होईपर्यंत किंवा थांबेपर्यंत Watcher काहीही नवीन सुरू करत नाही. तुमची वाट पाहणारा थ्रेडही मोजला जातो."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher starter ikke noe nytt før en av disse er ferdig eller stopper. En tråd som venter på deg, teller fortsatt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher start niets nieuws tot een van deze klaar is of stopt. Een thread die op jou wacht, telt ook mee."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher nie zacznie niczego nowego, dopóki któryś z nich się nie skończy lub nie zatrzyma. Wątek czekający na ciebie też się liczy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Watcher não inicia nada novo até uma destas terminar ou parar. Uma conversa aguardando você também conta."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Watcher não inicia nada de novo até uma destas terminar ou parar. Uma conversa à espera de si continua a contar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher nu pornește nimic nou până nu se termină sau se oprește unul dintre acestea. Un fir care te așteaptă contează și el."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher startar inget nytt förrän någon av dessa blir klar eller stoppar. En tråd som väntar på dig räknas fortfarande."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இவற்றில் ஒன்று முடியும் வரை அல்லது நிற்கும் வரை Watcher புதிதாக எதையும் தொடங்காது. உங்களுக்காகக் காத்திருக்கும் த்ரெட்டும் கணக்கில் வரும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "వీటిలో ఒకటి పూర్తయ్యే వరకు లేదా ఆగే వరకు Watcher కొత్తది ఏదీ ప్రారంభించదు. మీ కోసం వేచి ఉన్న థ్రెడ్ కూడా లెక్కలోకి వస్తుంది."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bunlardan biri bitene ya da durana kadar Watcher yeni bir şey başlatmaz. Sizi bekleyen bir sohbet de sayılır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher не почне нічого нового, доки один із цих тредів не завершиться чи не зупиниться. Тред, що чекає на вас, теж враховується."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جب تک ان میں سے کوئی ختم نہ ہو یا رک نہ جائے، Watcher کچھ نیا شروع نہیں کرتا۔ آپ کا منتظر تھریڈ بھی شمار ہوتا ہے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在其中一个完成或停止之前，Watcher 不会启动新的会话。等待你处理的会话也计算在内。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在其中一個完成或停止之前，Watcher 不會啟動新的對話。等待你處理的對話也計算在內。"
          }
        }
      }
    },
