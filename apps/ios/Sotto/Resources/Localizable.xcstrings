    "You sent here yourself. Until that turn ends, Watcher can only steer it." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أرسلت إلى هنا بنفسك. حتى ينتهي ذلك الدور، لا يستطيع Watcher إلا توجيهه."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনি নিজে এখানে পাঠিয়েছেন। সেই টার্ন শেষ না হওয়া পর্যন্ত Watcher শুধু এটি স্টিয়ার করতে পারে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem jste napsali sami. Do konce tohoto kola ho Watcher může jen usměrňovat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du sendte selv hertil. Indtil den omgang slutter, kan Watcher kun styre den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast selbst hierher gesendet. Bis dieser Durchgang endet, kann Watcher ihn nur steuern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Στείλατε εδώ εσείς. Μέχρι να τελειώσει εκείνος ο γύρος, ο Watcher μπορεί μόνο να τον καθοδηγήσει."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You sent here yourself. Until that turn ends, Watcher can only steer it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tú has enviado algo aquí. Hasta que termine ese turno, Watcher solo puede redirigirlo."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tú enviaste algo aquí. Hasta que termine ese turno, Watcher solo puede redirigirlo."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tú enviaste algo aquí. Hasta que termine ese turno, Watcher solo puede redirigirlo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lähetit tänne itse. Kunnes se vuoro päättyy, Watcher voi vain ohjata sitä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez envoyé un message ici vous-même. Jusqu’à la fin de ce tour, Watcher peut seulement l’orienter."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपने यहाँ खुद भेजा है। वह टर्न खत्म होने तक, Watcher इसे सिर्फ़ दिशा दे सकता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
