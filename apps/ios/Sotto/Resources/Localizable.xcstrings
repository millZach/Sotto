    "Watched by Watcher. While your own turn here runs, it can only steer that turn." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يراقبها Watcher. أثناء دورك هنا، لا يستطيع إلا توجيه ذلك الدور."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher নজরে রাখছে। এখানে আপনার নিজের টার্ন চলার সময় এটি শুধু সেই টার্ন স্টিয়ার করতে পারে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleduje Watcher. Zatímco tu běží vaše kolo, může ho jen usměrňovat."
