    "The theme colours the light at the top of each screen, what’s working and what you can tap." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تلوّن السمة الضوء أعلى كل شاشة، وما يعمل، وما يمكنك النقر عليه."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "থিম প্রতিটি স্ক্রিনের উপরের আলো, যা কাজ করছে এবং যেখানে আপনি ট্যাপ করতে পারেন, সেগুলোর রং ঠিক করে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Motiv barví světlo v horní části každé obrazovky, to, co pracuje, a to, na co lze klepnout."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temaet farver lyset øverst på hver skærm, det der arbejder, og det du kan trykke på."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Thema färbt das Licht oben auf jedem Bildschirm, was gerade arbeitet und worauf du tippen kannst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το θέμα χρωματίζει το φως στο πάνω μέρος κάθε οθόνης, ό,τι βρίσκεται σε εξέλιξη και ό,τι μπορείτε να πατήσετε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The theme colours the light at the top of each screen, what’s working and what you can tap."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El tema da color a la luz de la parte superior de cada pantalla, a lo que está trabajando y a lo que puedes tocar."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El tema da color a la luz de la parte superior de cada pantalla, a lo que está trabajando y a lo que puedes tocar."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El tema da color a la luz de la parte superior de cada pantalla, a lo que está trabajando y a lo que puedes tocar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teema värittää valon jokaisen näytön yläreunassa, sen mikä on työn alla, ja sen, mitä voit napauttaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le thème colore la lumière en haut de chaque écran, ce qui est en cours et ce que vous pouvez toucher."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "थीम हर स्क्रीन के ऊपर की रोशनी को, जो काम चल रहा है उसे और जिस पर आप टैप कर सकते हैं उसे रंग देती है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A téma színezi a képernyők tetején lévő fényt, azt, ami éppen dolgozik, és amit megérinthetsz."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tema colora la luce in cima a ogni schermata, ciò che è in corso e ciò che puoi toccare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "テーマは、各画面上部の光、作業中の表示、タップできる部分に色を付けます。"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "थीम प्रत्येक स्क्रीनच्या वरच्या प्रकाशाला, जे काम चालू आहे त्याला आणि तुम्ही जिथे टॅप करू शकता त्याला रंग देते."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temaet farger lyset øverst på hver skjerm, det som jobber, og det du kan trykke på."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het thema kleurt het licht boven aan elk scherm, wat bezig is en waar je op kunt tikken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
