    "Work carries on there. Your drafts are kept." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستمر العمل هناك. مسوداتك محفوظة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ওখানে কাজ চলতে থাকে। আপনার খসড়াগুলো রাখা আছে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Práce tam pokračuje. Vaše koncepty zůstávají."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arbejdet fortsætter der. Dine kladder gemmes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Arbeit geht dort weiter. Deine Entwürfe bleiben erhalten."
          }
