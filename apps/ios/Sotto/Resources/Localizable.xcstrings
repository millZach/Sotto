    "A default applies only where the chosen computer offers it. A computer that hasn’t let this iPhone answer starts every thread by asking." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يُطبَّق الإعداد الافتراضي إلا حيث يوفره الكمبيوتر المختار. والكمبيوتر الذي لم يسمح لهذا الـ iPhone بالإجابة يبدأ كل محادثة بالسؤال."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "একটি ডিফল্ট শুধু সেখানেই খাটে যেখানে বেছে নেওয়া কম্পিউটার সেটি দেয়। যে কম্পিউটার এই iPhone-কে উত্তর দিতে দেয়নি, সেটি প্রতিটি থ্রেড জিজ্ঞাসা করে শুরু করে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Výchozí hodnota platí jen tam, kde ji vybraný počítač nabízí. Počítač, který tomuto iPhonu nedovolil odpovídat, začíná každé vlákno dotazem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En standard gælder kun, hvor den valgte computer tilbyder den. En computer, der ikke har givet denne iPhone lov til at svare, starter hver tråd med at spørge."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Voreinstellung gilt nur, wo der gewählte Computer sie anbietet. Ein Computer, der dieses iPhone nicht antworten lässt, startet jeden Thread mit Nachfragen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μια προεπιλογή ισχύει μόνο όπου την προσφέρει ο επιλεγμένος υπολογιστής. Ένας υπολογιστής που δεν έχει επιτρέψει σε αυτό το iPhone να απαντά ξεκινά κάθε νήμα ρωτώντας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A default applies only where the chosen computer offers it. A computer that hasn’t let this iPhone answer starts every thread by asking."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un valor predeterminado solo se aplica donde el ordenador elegido lo ofrece. Un ordenador que no ha permitido que este iPhone responda empieza cada hilo preguntando."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un valor predeterminado solo se aplica donde la computadora elegida lo ofrece. Una computadora que no ha permitido que este iPhone responda empieza cada hilo preguntando."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un valor predeterminado solo se aplica donde la computadora elegida lo ofrece. Una computadora que no ha permitido que este iPhone responda empieza cada hilo preguntando."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oletusta käytetään vain, jos valittu tietokone tarjoaa sen. Tietokone, joka ei ole antanut tämän iPhonen vastata, aloittaa jokaisen ketjun kysymällä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une valeur par défaut ne s’applique que là où l’ordinateur choisi la propose. Un ordinateur qui n’a pas autorisé cet iPhone à répondre commence chaque fil en demandant."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डिफ़ॉल्ट सिर्फ़ वहीं लागू होता है जहाँ चुना गया कंप्यूटर उसे देता है। जिस कंप्यूटर ने इस iPhone को जवाब देने नहीं दिया है, वह हर थ्रेड पूछकर शुरू करता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egy alapértelmezés csak ott érvényes, ahol a kiválasztott számítógép kínálja. Az a számítógép, amely nem engedte, hogy ez az iPhone válaszoljon, minden szálat úgy indít, hogy előbb kérdez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un’impostazione predefinita si applica solo dove il computer scelto la offre. Un computer che non ha consentito a questo iPhone di rispondere inizia ogni thread chiedendo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デフォルトは、選択したコンピュータが対応している場合にだけ適用されます。この iPhone からの回答を許可していないコンピュータでは、すべてのスレッドが確認を求めるモードで開始します。"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डीफॉल्ट फक्त तिथेच लागू होतो जिथे निवडलेला कॉम्प्युटर तो देतो. ज्या कॉम्प्युटरने या iPhone ला उत्तर देऊ दिलेले नाही, तो प्रत्येक थ्रेड विचारून सुरू करतो."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En standard gjelder bare der den valgte datamaskinen tilbyr den. En datamaskin som ikke har latt denne iPhonen svare, starter alle tråder med å spørre."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een standaard geldt alleen als de gekozen computer hem aanbiedt. Een computer die deze iPhone niet laat antwoorden, begint elke thread met vragen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustawienie domyślne działa tylko tam, gdzie wybrany komputer je oferuje. Komputer, który nie pozwolił temu iPhone’owi odpowiadać, zaczyna każdy wątek od pytania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um padrão só vale onde o computador escolhido o oferece. Um computador que não permitiu que este iPhone responda começa toda conversa pedindo permissão."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma predefinição só se aplica onde o computador escolhido a oferece. Um computador que não deixou este iPhone responder começa todas as conversas por perguntar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O valoare implicită se aplică doar unde computerul ales o oferă. Un computer care nu a permis acestui iPhone să răspundă începe fiecare fir prin a întreba."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ett standardval gäller bara där den valda datorn erbjuder det. En dator som inte har låtit den här iPhone svara startar varje tråd med att fråga."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "தேர்ந்தெடுத்த கணினி வழங்கும் இடத்தில் மட்டுமே இயல்புநிலை பொருந்தும். இந்த iPhone ஐப் பதிலளிக்க அனுமதிக்காத கணினி ஒவ்வொரு த்ரெட்டையும் கேட்பதுடன் தொடங்கும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఎంచుకున్న కంప్యూటర్ అందించే చోట మాత్రమే డిఫాల్ట్ వర్తిస్తుంది. ఈ iPhoneను సమాధానం ఇవ్వనివ్వని కంప్యూటర్ ప్రతి థ్రెడ్‌ను అడగడంతో ప్రారంభిస్తుంది."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir varsayılan yalnızca seçilen bilgisayar onu sunuyorsa uygulanır. Bu iPhone’un cevaplamasına izin vermemiş bir bilgisayar her sohbeti sorarak başlatır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Типове значення діє лише там, де вибраний комп’ютер його пропонує. Комп’ютер, який не дозволив цьому iPhone відповідати, у кожному треді спершу питає дозволу."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ڈیفالٹ صرف وہاں لاگو ہوتا ہے جہاں منتخب کمپیوٹر اسے پیش کرے۔ جس کمپیوٹر نے اس iPhone کو جواب دینے نہیں دیا، وہ ہر تھریڈ پوچھ کر شروع کرتا ہے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "默认设置只在所选电脑提供该选项时生效。尚未允许此 iPhone 答复的电脑会让每个会话先询问。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "預設值只在所選電腦提供該選項時生效。尚未允許此 iPhone 答覆的電腦會讓每個對話先詢問。"
          }
        }
      }
    },
    "A file couldn’t reach %@, so nothing was sent. Try again when it’s connected." : {
      "comment" : "%@ is the computer's name",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر وصول ملف إلى %@، لذا لم يُرسَل شيء. حاول مرة أخرى عند اتصاله."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "একটি ফাইল %@-এ পৌঁছায়নি, তাই কিছুই পাঠানো হয়নি। এটি সংযুক্ত হলে আবার চেষ্টা করুন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soubor se nepodařilo přenést na %@, takže nic nebylo odesláno. Zkuste to znovu, až bude připojen."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En fil kunne ikke nå %@, så intet blev sendt. Prøv igen, når computeren er forbundet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Datei hat %@ nicht erreicht, daher wurde nichts gesendet. Versuch es erneut, wenn der Computer verbunden ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ένα αρχείο δεν έφτασε στον υπολογιστή %@, οπότε δεν στάλθηκε τίποτα. Δοκιμάστε ξανά όταν είναι συνδεδεμένος."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A file couldn’t reach %@, so nothing was sent. Try again when it’s connected."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un archivo no ha podido llegar a %@, así que no se ha enviado nada. Inténtalo de nuevo cuando haya conexión."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un archivo no pudo llegar a %@, así que no se envió nada. Inténtalo de nuevo cuando haya conexión."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un archivo no pudo llegar a %@, así que no se envió nada. Inténtalo de nuevo cuando haya conexión."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiedosto ei päässyt tietokoneelle %@, joten mitään ei lähetetty. Yritä uudelleen, kun se on yhdistettynä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un fichier n’a pas pu parvenir à %@, rien n’a donc été envoyé. Réessayez quand il sera connecté."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक फ़ाइल %@ तक नहीं पहुँच सकी, इसलिए कुछ नहीं भेजा गया। कनेक्ट होने पर फिर से कोशिश करें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
