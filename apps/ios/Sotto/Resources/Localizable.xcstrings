    "Threads you started or took over keep going, and so does Watcher." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تستمر المحادثات التي بدأتها أو توليتها، ويستمر Watcher أيضًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার শুরু করা বা নিজের হাতে নেওয়া থ্রেডগুলো চলতে থাকে, Watcher-ও চলতে থাকে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vlákna, která jste spustili nebo převzali, pokračují, stejně jako Watcher."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tråde, du startede eller overtog, fortsætter, og det gør Watcher også."
