        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoja wiadomość do wątku na %@ nie trafiła do kolejki. Jej tekst wrócił do tamtego wątku."
          }
        },
        "pt-BR" : {
