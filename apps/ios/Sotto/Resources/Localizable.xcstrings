          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ultima încercare a lui Watcher, la %@, nu a ajuns."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watchers senaste försök kl. %@ nådde inte fram."
