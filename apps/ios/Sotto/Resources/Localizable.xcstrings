    "Watcher isn’t running on %@. Start it in Sotto on %@, then ask it here." : {
      "comment" : "Both placeholders are the computer's name",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher لا يعمل على %@. شغّله في Sotto على %@، ثم اسأله هنا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@-এ Watcher চলছে না। %@-এ Sotto-তে এটি চালু করুন, তারপর এখানে জিজ্ঞাসা করুন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher na %@ neběží. Spusťte ho v Sotto na %@ a pak se ho zeptejte tady."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher kører ikke på %@. Start den i Sotto på %@, og spørg så her."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher läuft nicht auf %@. Starte ihn in Sotto auf %@ und frag ihn dann hier."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο Watcher δεν εκτελείται στον υπολογιστή %@. Ξεκινήστε τον στο Sotto στον υπολογιστή %@ και μετά ρωτήστε τον εδώ."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
