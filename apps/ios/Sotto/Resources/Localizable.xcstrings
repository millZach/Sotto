    "Saved unconfirmed actions could not be read. Check your threads before sending again. Nothing was resent." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّرت قراءة الإجراءات غير المؤكدة المحفوظة. تحقق من محادثاتك قبل الإرسال مجددًا. لم يُعَد إرسال شيء."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সংরক্ষিত অনিশ্চিত কাজগুলো পড়া যায়নি। আবার পাঠানোর আগে আপনার থ্রেডগুলো দেখে নিন। কিছুই আবার পাঠানো হয়নি।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uložené nepotvrzené akce se nepodařilo načíst. Než znovu něco pošlete, zkontrolujte vlákna. Nic nebylo znovu odesláno."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gemte, ubekræftede handlinger kunne ikke læses. Tjek dine tråde, før du sender igen. Intet blev sendt igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gespeicherte unbestätigte Aktionen konnten nicht gelesen werden. Prüfe deine Threads, bevor du erneut sendest. Nichts wurde erneut gesendet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν ήταν δυνατή η ανάγνωση των αποθηκευμένων μη επιβεβαιωμένων ενεργειών. Ελέγξτε τα νήματά σας πριν στείλετε ξανά. Δεν στάλθηκε τίποτα ξανά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saved unconfirmed actions could not be read. Check your threads before sending again. Nothing was resent."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se han podido leer las acciones sin confirmar guardadas. Revisa tus hilos antes de volver a enviar. No se ha reenviado nada."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudieron leer las acciones sin confirmar guardadas. Revisa tus hilos antes de volver a enviar. No se reenvió nada."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudieron leer las acciones sin confirmar guardadas. Revisa tus hilos antes de volver a enviar. No se reenvió nada."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tallennettuja vahvistamattomia toimintoja ei voitu lukea. Tarkista ketjusi ennen kuin lähetät uudelleen. Mitään ei lähetetty uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de lire les actions non confirmées enregistrées. Vérifiez vos fils avant d’envoyer à nouveau. Rien n’a été renvoyé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सहेजी गई अपुष्ट कार्रवाइयाँ नहीं पढ़ी जा सकीं। दोबारा भेजने से पहले अपने थ्रेड जाँच लें। कुछ भी दोबारा नहीं भेजा गया।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A mentett, meg nem erősített műveletek nem olvashatók be. Nézd meg a szálaidat, mielőtt újra küldesz. Semmi sem ment el újra."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile leggere le azioni non confermate salvate. Controlla i tuoi thread prima di inviare di nuovo. Non è stato reinviato nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存された未確認の操作を読み込めませんでした。もう一度送信する前にスレッドを確認してください。再送信されたものはありません。"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जतन केलेल्या, पुष्टी न झालेल्या कृती वाचता आल्या नाहीत. पुन्हा पाठवण्याआधी तुमचे थ्रेड तपासा. काहीही पुन्हा पाठवले नाही."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke lese lagrede ubekreftede handlinger. Sjekk trådene dine før du sender igjen. Ingenting ble sendt på nytt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewaarde onbevestigde acties kunnen niet worden gelezen. Bekijk je threads voordat je opnieuw verstuurt. Er is niets opnieuw verstuurd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się odczytać zapisanych niepotwierdzonych działań. Sprawdź wątki, zanim wyślesz ponownie. Nic nie zostało wysłane ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível ler as ações não confirmadas salvas. Confira suas conversas antes de enviar de novo. Nada foi reenviado."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível ler as ações não confirmadas guardadas. Verifique as conversas antes de enviar novamente. Nada foi reenviado."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acțiunile neconfirmate salvate nu au putut fi citite. Verifică firele înainte să trimiți din nou. Nu s-a retrimis nimic."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sparade obekräftade åtgärder kunde inte läsas. Kontrollera dina trådar innan du skickar igen. Inget skickades igen."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "சேமித்த உறுதிப்படுத்தப்படாத செயல்களைப் படிக்க முடியவில்லை. மீண்டும் அனுப்பும் முன் உங்கள் த்ரெட்களைச் சரிபார்க்கவும். எதுவும் மீண்டும் அனுப்பப்படவில்லை."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "సేవ్ చేసిన ధృవీకరించని చర్యలను చదవలేకపోయింది. మళ్లీ పంపే ముందు మీ థ్రెడ్‌లను తనిఖీ చేయండి. ఏదీ మళ్లీ పంపలేదు."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaydedilmiş onaylanmamış işlemler okunamadı. Yeniden göndermeden önce sohbetlerinizi kontrol edin. Hiçbir şey yeniden gönderilmedi."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не вдалося прочитати збережені непідтверджені дії. Перевірте треди, перш ніж надсилати знову. Нічого не надіслано повторно."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "محفوظ کی گئی غیر تصدیق شدہ کارروائیاں پڑھی نہیں جا سکیں۔ دوبارہ بھیجنے سے پہلے اپنے تھریڈز دیکھ لیں۔ کچھ دوبارہ نہیں بھیجا گیا۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法读取已保存的未确认操作。再次发送前，请先查看你的会话。未重新发送任何内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法讀取已儲存的未確認動作。再次傳送前，請先查看你的對話。沒有重新傳送任何內容。"
          }
        }
      }
    },
