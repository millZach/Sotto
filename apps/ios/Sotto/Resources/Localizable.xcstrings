    "%@ can’t be reached, so the pull request wasn’t read. Reconnect and try again." : {
      "comment" : "%@ is the computer's name",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر الوصول إلى %@، لذا لم تتم قراءة طلب السحب. أعد الاتصال وحاول مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@-এ পৌঁছানো যাচ্ছে না, তাই পুল রিকোয়েস্ট পড়া হয়নি। আবার সংযোগ করে আবার চেষ্টা করুন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S %@ se nelze spojit, takže pull request nebyl načten. Připojte se znovu a zkuste to ještě jednou."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kan ikke nås, så pull requesten blev ikke læst. Opret forbindelse igen, og prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist nicht erreichbar, daher wurde der Pull Request nicht gelesen. Verbinde dich neu und versuch es noch einmal."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο υπολογιστής %@ δεν είναι προσβάσιμος, οπότε το pull request δεν διαβάστηκε. Συνδεθείτε ξανά και δοκιμάστε ξανά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ can’t be reached, so the pull request wasn’t read. Reconnect and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede conectar con %@, así que no se ha leído el pull request. Vuelve a conectarte e inténtalo de nuevo."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede conectar con %@, así que no se leyó el pull request. Vuelve a conectarte e inténtalo de nuevo."
