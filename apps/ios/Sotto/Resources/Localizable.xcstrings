    "Stop all couldn’t be checked on %@. Nothing was stopped. Try again." : {
      "comment" : "Stop all is the name of a button. %@ is the computer's name",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر التحقق من «إيقاف الكل» على %@. لم يتوقف شيء. حاول مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@-এ “সব থামান” যাচাই করা যায়নি। কিছুই থামানো হয়নি। আবার চেষ্টা করুন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Zastavit vše“ se na %@ nepodařilo ověřit. Nic nebylo zastaveno. Zkuste to znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stop alle kunne ikke tjekkes på %@. Intet blev stoppet. Prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Alle stoppen“ konnte auf %@ nicht geprüft werden. Nichts wurde gestoppt. Versuch es erneut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν ήταν δυνατός ο έλεγχος της «Διακοπή όλων» στον υπολογιστή %@. Δεν διακόπηκε τίποτα. Δοκιμάστε ξανά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stop all couldn’t be checked on %@. Nothing was stopped. Try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido comprobar Detener todo en %@. No se ha detenido nada. Inténtalo de nuevo."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo verificar Detener todo en %@. No se detuvo nada. Inténtalo de nuevo."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo verificar Detener todo en %@. No se detuvo nada. Inténtalo de nuevo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pysäytä kaikki -toimintoa ei voitu tarkistaa tietokoneella %@. Mitään ei pysäytetty. Yritä uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de vérifier « Tout arrêter » sur %@. Rien n’a été arrêté. Réessayez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ पर “सब रोकें” की जाँच नहीं हो सकी। कुछ नहीं रोका गया। फिर से कोशिश करें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az Összes leállítása nem ellenőrizhető a(z) %@ számítógépen. Semmi sem állt le. Próbáld újra."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile controllare “Ferma tutto” su %@. Non è stato fermato nulla. Riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ で「すべて停止」を確認できませんでした。何も停止されていません。もう一度お試しください。"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ वर “सर्व थांबवा” तपासता आले नाही. काहीही थांबवले नाही. पुन्हा प्रयत्न करा."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke sjekke Stopp alle på %@. Ingenting ble stoppet. Prøv igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stop alles kan niet worden gecontroleerd op %@. Er is niets gestopt. Probeer opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się sprawdzić „Zatrzymaj wszystkie” na %@. Nic nie zostało zatrzymane. Spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível verificar Parar tudo em %@. Nada foi parado. Tente novamente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível verificar Parar tudo em %@. Nada foi parado. Tente novamente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Oprește tot” nu a putut fi verificat pe %@. Nu s-a oprit nimic. Încearcă din nou."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stoppa alla kunde inte kontrolleras på %@. Inget stoppades. Försök igen."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ இல் “அனைத்தையும் நிறுத்து” என்பதைச் சரிபார்க்க முடியவில்லை. எதுவும் நிறுத்தப்படவில்லை. மீண்டும் முயலவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@లో “అన్నీ ఆపండి”ని తనిఖీ చేయలేకపోయింది. ఏదీ ఆపలేదు. మళ్లీ ప్రయత్నించండి."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Tümünü Durdur” %@ üzerinde kontrol edilemedi. Hiçbir şey durdurulmadı. Yeniden deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
