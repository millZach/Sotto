          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temat färgar ljuset högst upp på varje skärm, det som arbetar och det du kan trycka på."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ஒவ்வொரு திரையின் மேலே உள்ள ஒளிக்கும், வேலை செய்பவற்றுக்கும், நீங்கள் தட்டக்கூடியவற்றுக்கும் தீம் வண்ணம் தருகிறது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ప్రతి స్క్రీన్ పైభాగంలోని కాంతికి, పని చేస్తున్నవాటికి, మీరు నొక్కగలిగేవాటికి థీమ్ రంగు ఇస్తుంది."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tema; her ekranın üstündeki ışığı, çalışan şeyleri ve dokunabileceğiniz öğeleri renklendirir."
