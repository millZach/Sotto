    "Reconnect a computer in Computers before starting a thread." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أعد الاتصال بكمبيوتر من «أجهزة الكمبيوتر» قبل بدء محادثة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "থ্রেড শুরু করার আগে “কম্পিউটার”-এ একটি কম্পিউটারে আবার সংযোগ করুন।"
          }
        },
        "cs" : {
          "stringUnit" : {
