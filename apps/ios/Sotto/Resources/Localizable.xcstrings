    "It is watched for a request: if you send to it yourself, Watcher stops sending to it." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إنها مُراقَبة من أجل طلب: إذا أرسلت إليها بنفسك، يتوقف Watcher عن الإرسال إليها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এটি একটি অনুরোধের জন্য নজরে আছে: আপনি নিজে এতে পাঠালে Watcher এতে পাঠানো বন্ধ করে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je sledované kvůli zadání: pokud do něj napíšete sami, Watcher do něj přestane posílat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den overvåges for en anmodning: Hvis du selv sender til den, stopper Watcher med at sende til den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er wird für eine Anfrage beobachtet: Wenn du selbst an ihn sendest, sendet Watcher nicht mehr an ihn."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Παρακολουθείται για ένα αίτημα: αν του στείλετε εσείς, ο Watcher σταματά να του στέλνει."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It is watched for a request: if you send to it yourself, Watcher stops sending to it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se vigila por una solicitud: si tú le envías algo, Watcher deja de enviarle."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se vigila por una solicitud: si tú le envías algo, Watcher deja de enviarle."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se vigila por una solicitud: si tú le envías algo, Watcher deja de enviarle."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sitä valvotaan pyynnön vuoksi: jos lähetät sille itse, Watcher lakkaa lähettämästä sille."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il est surveillé pour une demande : si vous lui envoyez vous-même un message, Watcher cesse de lui en envoyer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसकी निगरानी एक अनुरोध के लिए हो रही है: अगर आप खुद इसे भेजते हैं, तो Watcher इसे भेजना बंद कर देता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egy kérés miatt figyelt: ha te magad küldesz neki, a Watcher nem küld neki tovább."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È monitorato per una richiesta: se gli invii tu stesso un messaggio, Watcher smette di inviargliene."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リクエストのために見守られています。あなたが自分で送信すると、Watcher はこのスレッドへの送信をやめます。"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "त्यावर एका विनंतीसाठी लक्ष आहे: तुम्ही स्वतः त्याला पाठवल्यास, Watcher त्याला पाठवणे थांबवतो."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den overvåkes for en forespørsel: Hvis du sender til den selv, slutter Watcher å sende til den."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hij wordt gevolgd voor een verzoek: als je er zelf iets naar verstuurt, stopt Watcher met versturen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jest obserwowany na czas zlecenia: jeśli napiszesz do niego samodzielnie, Watcher przestanie do niego wysyłać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ela é vigiada por causa de um pedido: se você mesmo enviar algo a ela, o Watcher deixa de enviar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "É vigiada por causa de um pedido: se lhe enviar algo, o Watcher deixa de lhe enviar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E urmărit pentru o solicitare: dacă îi trimiți tu ceva, Watcher nu îi mai trimite."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den bevakas för en begäran: om du själv skickar till den slutar Watcher skicka till den."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இது ஒரு கோரிக்கைக்காகக் கவனிக்கப்படுகிறது: நீங்களே இதற்கு அனுப்பினால், Watcher இதற்கு அனுப்புவதை நிறுத்தும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఇది ఒక అభ్యర్థన కోసం గమనించబడుతోంది: మీరే దీనికి పంపితే, Watcher దీనికి పంపడం ఆపుతుంది."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir istek için izleniyor: ona kendiniz gönderirseniz Watcher ona göndermeyi bırakır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Він відстежується заради запиту: якщо ви надішлете в нього самі, Watcher перестане туди надсилати."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یہ ایک درخواست کے لیے زیر نگرانی ہے: اگر آپ خود اسے بھیجیں تو Watcher اسے بھیجنا بند کر دیتا ہے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它因一个请求而被监看：如果你亲自向它发送内容，Watcher 就会停止向它发送。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它因一個請求而受到監看：如果你親自傳送內容給它，Watcher 就會停止傳送給它。"
          }
        }
      }
    },
    "It may already have reached %@. Nothing is sent again." : {
      "extractionState" : "manual",
