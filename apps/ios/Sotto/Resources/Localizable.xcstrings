    "Removing isn’t confirmed. Check the thread’s queue before you remove it again." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الإزالة غير مؤكدة. تحقق من قائمة انتظار المحادثة قبل أن تزيلها مجددًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সরানো নিশ্চিত হয়নি। আবার সরানোর আগে থ্রেডের সারি দেখে নিন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odstranění není potvrzeno. Než zprávu znovu odstraníte, zkontrolujte frontu vlákna."
