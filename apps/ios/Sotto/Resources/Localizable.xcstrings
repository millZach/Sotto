    "A question or permission is waiting, Watcher’s own too." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سؤال أو إذن بانتظارك، بما في ذلك ما يخص Watcher."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "একটি প্রশ্ন বা অনুমতি অপেক্ষা করছে, Watcher-এর নিজেরগুলোও।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čeká otázka nebo povolení, i od Watchera."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et spørgsmål eller en tilladelse venter, også Watchers egne."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Frage oder Berechtigung wartet, auch von Watcher."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μια ερώτηση ή άδεια περιμένει, και του ίδιου του Watcher."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
