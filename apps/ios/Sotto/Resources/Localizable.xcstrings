        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu respuesta a un hilo en %@ no se puso en cola. Su texto volvió a ese hilo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vastaustasi ketjuun tietokoneella %@ ei lisätty jonoon. Sen teksti on palautettu siihen ketjuun."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre réponse à un fil sur %@ n’a pas été mise en file d’attente. Son texte est de retour dans ce fil."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ पर एक थ्रेड को भेजा गया आपका रिप्लाई कतार में नहीं लगा। उसका टेक्स्ट वापस उस थ्रेड में है।"
