    "%@ isn’t connected on %@, so Watcher can’t take messages. Nothing was sent." : {
      "comment" : "The first placeholder is the provider's name, such as Codex; the second is the computer's name",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ غير متصل على %@، لذا لا يستطيع Watcher تلقي الرسائل. لم يُرسَل شيء."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ %@-এ সংযুক্ত নেই, তাই Watcher বার্তা নিতে পারছে না। কিছুই পাঠানো হয়নি।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ není na %@ připojen, takže Watcher nemůže přijímat zprávy. Nic nebylo odesláno."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ er ikke forbundet på %@, så Watcher kan ikke modtage beskeder. Intet blev sendt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist auf %@ nicht verbunden, daher kann Watcher keine Nachrichten annehmen. Nichts wurde gesendet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το %@ δεν είναι συνδεδεμένο στον υπολογιστή %@, οπότε ο Watcher δεν μπορεί να δεχτεί μηνύματα. Δεν στάλθηκε τίποτα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ isn’t connected on %@, so Watcher can’t take messages. Nothing was sent."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no está conectado en %@, así que Watcher no puede recibir mensajes. No se ha enviado nada."
