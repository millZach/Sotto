        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ پر ایک تھریڈ کو آپ کا ریپلائی قطار میں نہیں لگا۔ اس کا متن اسی تھریڈ میں واپس ہے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你给 %@ 上某个会话的回复未加入队列。其文字已放回该会话。"
