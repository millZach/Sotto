    "Settling isn’t confirmed. Check the thread before you settle it again." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التنحية غير مؤكدة. تحقق من المحادثة قبل تنحيتها مجددًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সরিয়ে রাখা নিশ্চিত হয়নি। আবার সরিয়ে রাখার আগে থ্রেডটি দেখে নিন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odložení není potvrzeno. Než vlákno znovu odložíte, zkontrolujte ho."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det er ikke bekræftet, at tråden er lagt til side. Tjek tråden, før du lægger den til side igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Ablegen ist nicht bestätigt. Prüfe den Thread, bevor du ihn erneut ablegst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο παραμερισμός δεν επιβεβαιώθηκε. Ελέγξτε το νήμα πριν το παραμερίσετε ξανά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Settling isn’t confirmed. Check the thread before you settle it again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No está confirmado que se haya apartado. Revisa el hilo antes de volver a apartarlo."
