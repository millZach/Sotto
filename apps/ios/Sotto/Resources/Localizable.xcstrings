        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ पर %1$@ कनेक्ट नहीं है, इसलिए Watcher संदेश नहीं ले सकता। कुछ नहीं भेजा गया।"
