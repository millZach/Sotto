        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ तक नहीं पहुँचा जा सकता, इसलिए पुल रिक्वेस्ट नहीं पढ़ी गई। फिर से कनेक्ट करें और फिर से कोशिश करें।"
