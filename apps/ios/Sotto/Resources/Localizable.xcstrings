        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una domanda o un’autorizzazione è in attesa, anche quelle di Watcher."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "質問や許可が待機しているとき。Watcher 自身のものも含みます。"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एखादा प्रश्न किंवा परवानगी प्रतीक्षेत आहे, Watcher ची स्वतःचीही."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et spørsmål eller en tillatelse venter, også fra Watcher."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er wacht een vraag of toestemming, ook die van Watcher zelf."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czeka pytanie lub pozwolenie, także Watchera."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Há uma pergunta ou permissão aguardando, inclusive do Watcher."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Há uma pergunta ou permissão à espera, incluindo as do próprio Watcher."
          }
        },
        "ro" : {
          "stringUnit" : {
