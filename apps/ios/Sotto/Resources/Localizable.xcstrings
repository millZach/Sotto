    "Compacting isn’t confirmed. Check the thread before you compact it again." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الضغط غير مؤكد. تحقق من المحادثة قبل ضغطها مجددًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ছোট করা নিশ্চিত হয়নি। আবার ছোট করার আগে থ্রেডটি দেখে নিন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zhuštění není potvrzeno. Než kontext znovu zhustíte, zkontrolujte vlákno."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Komprimeringen er ikke bekræftet. Tjek tråden, før du komprimerer den igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Verdichten ist nicht bestätigt. Prüfe den Thread, bevor du erneut verdichtest."
