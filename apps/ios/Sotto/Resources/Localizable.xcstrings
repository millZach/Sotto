    "Watcher’s last try at %@ didn’t reach it." : {
      "comment" : "%@ is a time of day",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم تصل محاولة Watcher الأخيرة في %@ إليها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@-এ Watcher-এর শেষ চেষ্টা এতে পৌঁছায়নি।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poslední pokus Watchera v %@ nedorazil."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watchers seneste forsøg kl. %@ nåede ikke frem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der letzte Versuch von Watcher um %@ ist nicht angekommen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η τελευταία προσπάθεια του Watcher στις %@ δεν έφτασε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher’s last try at %@ didn’t reach it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El último intento de Watcher, a las %@, no ha llegado."
