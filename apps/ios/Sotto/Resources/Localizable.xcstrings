        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@లోని ఒక థ్రెడ్‌కు మీ ప్రత్యుత్తరం క్యూలో చేరలేదు. దాని టెక్స్ట్ తిరిగి ఆ థ్రెడ్‌లో ఉంది."
          }
        },
        "tr" : {
          "stringUnit" : {
