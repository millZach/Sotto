    "That code didn't work. Codes work once and last five minutes; get a new one on that computer." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يعمل ذلك الرمز. يعمل الرمز مرة واحدة ويبقى صالحًا خمس دقائق؛ احصل على رمز جديد من ذلك الكمبيوتر."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কোডটি কাজ করেনি। কোড একবারই কাজ করে এবং পাঁচ মিনিট থাকে; ওই কম্পিউটারে একটি নতুন কোড নিন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento kód nefungoval. Kód funguje jednou a platí pět minut; vygenerujte si na tom počítači nový."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koden virkede ikke. En kode virker én gang og gælder i fem minutter. Hent en ny på den computer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Code hat nicht funktioniert. Codes funktionieren einmal und gelten fünf Minuten. Hol dir auf diesem Computer einen neuen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτός ο κωδικός δεν λειτούργησε. Οι κωδικοί λειτουργούν μία φορά και ισχύουν πέντε λεπτά· πάρτε νέο από εκείνον τον υπολογιστή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That code didn't work. Codes work once and last five minutes; get a new one on that computer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ese código no ha funcionado. Cada código funciona una vez y dura cinco minutos; consigue uno nuevo en ese ordenador."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ese código no funcionó. Cada código funciona una vez y dura cinco minutos; obtén uno nuevo en esa computadora."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ese código no funcionó. Cada código funciona una vez y dura cinco minutos; obtén uno nuevo en esa computadora."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koodi ei toiminut. Koodi toimii kerran ja on voimassa viisi minuuttia. Hae uusi siltä tietokoneelta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce code n’a pas fonctionné. Un code ne sert qu’une fois et dure cinq minutes ; obtenez-en un nouveau sur cet ordinateur."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वह कोड काम नहीं आया। कोड एक ही बार काम करते हैं और पाँच मिनट तक चलते हैं; उस कंप्यूटर पर नया कोड लें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
