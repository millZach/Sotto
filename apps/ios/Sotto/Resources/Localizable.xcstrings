    "Watcher on %@ couldn’t be read. Nothing was lost. Pull down to read it again." : {
      "comment" : "%@ is the computer's name",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّرت قراءة Watcher على %@. لم يُفقد شيء. اسحب لأسفل لقراءته مجددًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@-এ Watcher পড়া যায়নি। কিছুই হারায়নি। আবার পড়তে নিচে টানুন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watchera na %@ se nepodařilo načíst. Nic se neztratilo. Stažením dolů ho načtete znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher på %@ kunne ikke læses. Intet gik tabt. Træk ned for at læse igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher auf %@ konnte nicht gelesen werden. Nichts ging verloren. Zieh nach unten, um ihn erneut zu lesen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν ήταν δυνατή η ανάγνωση του Watcher στον υπολογιστή %@. Δεν χάθηκε τίποτα. Σύρετε προς τα κάτω για νέα ανάγνωση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher on %@ couldn’t be read. Nothing was lost. Pull down to read it again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido leer Watcher en %@. No se ha perdido nada. Desliza hacia abajo para volver a leerlo."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo leer Watcher en %@. No se perdió nada. Desliza hacia abajo para volver a leerlo."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo leer Watcher en %@. No se perdió nada. Desliza hacia abajo para volver a leerlo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcheria ei voitu lukea tietokoneelta %@. Mitään ei kadonnut. Lue uudelleen vetämällä alas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de lire Watcher sur %@. Rien n’a été perdu. Tirez vers le bas pour le relire."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ पर Watcher को नहीं पढ़ा जा सका। कुछ भी नहीं खोया। फिर से पढ़ने के लिए नीचे खींचें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Watcher nem olvasható be a(z) %@ számítógépen. Semmi sem veszett el. Húzd le az újbóli beolvasáshoz."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile leggere Watcher su %@. Non è andato perso nulla. Trascina verso il basso per leggerlo di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ の Watcher を読み込めませんでした。失われたものはありません。下に引っ張って再読み込みしてください。"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ वरील Watcher वाचता आला नाही. काहीही गमावले नाही. पुन्हा वाचण्यासाठी खाली ओढा."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke lese Watcher på %@. Ingenting gikk tapt. Dra ned for å lese på nytt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher op %@ kan niet worden gelezen. Er is niets verloren gegaan. Trek omlaag om opnieuw te lezen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się odczytać Watchera na %@. Nic nie zostało utracone. Przeciągnij w dół, aby odczytać ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível ler o Watcher em %@. Nada foi perdido. Puxe para baixo para ler de novo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível ler o Watcher em %@. Nada se perdeu. Puxe para baixo para ler novamente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher de pe %@ nu a putut fi citit. Nu s-a pierdut nimic. Trage în jos pentru a-l citi din nou."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher på %@ kunde inte läsas. Inget gick förlorat. Dra nedåt för att läsa igen."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ இல் Watcher ஐப் படிக்க முடியவில்லை. எதுவும் இழக்கப்படவில்லை. மீண்டும் படிக்கக் கீழே இழுக்கவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@లో Watcherను చదవలేకపోయింది. ఏదీ కోల్పోలేదు. మళ్లీ చదవడానికి కిందికి లాగండి."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ üzerindeki Watcher okunamadı. Hiçbir şey kaybolmadı. Yeniden okumak için aşağı çekin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не вдалося прочитати Watcher на %@. Нічого не втрачено. Потягніть униз, щоб прочитати знову."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ پر Watcher پڑھا نہیں جا سکا۔ کچھ ضائع نہیں ہوا۔ دوبارہ پڑھنے کے لیے نیچے کھینچیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法读取 %@ 上的 Watcher。未丢失任何内容。下拉即可重新读取。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法讀取 %@ 上的 Watcher。沒有遺失任何內容。向下拉即可重新讀取。"
          }
        }
      }
    },
    "Watcher on %@ keeps it going and brings you its questions and permissions, until you stop it." : {
      "comment" : "%@ is the computer's name",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُبقيها Watcher على %@ مستمرة ويوصل إليك أسئلتها وأذوناتها، حتى توقفه."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@-এ Watcher আপনি না থামানো পর্যন্ত এটি চালিয়ে যায় এবং এর প্রশ্ন ও অনুমতি আপনার কাছে আনে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher na %@ ho udržuje v chodu a přináší vám jeho otázky a povolení, dokud ho nezastavíte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher på %@ holder den i gang og bringer dig dens spørgsmål og tilladelser, indtil du stopper den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher auf %@ hält ihn am Laufen und bringt dir seine Fragen und Berechtigungen, bis du ihn stoppst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο Watcher στον υπολογιστή %@ το συνεχίζει και σας φέρνει τις ερωτήσεις και τις άδειές του, μέχρι να τον σταματήσετε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher on %@ keeps it going and brings you its questions and permissions, until you stop it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher en %@ lo mantiene en marcha y te trae sus preguntas y permisos hasta que lo detengas."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher en %@ lo mantiene en marcha y te trae sus preguntas y permisos hasta que lo detengas."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher en %@ lo mantiene en marcha y te trae sus preguntas y permisos hasta que lo detengas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher tietokoneella %@ pitää sen käynnissä ja tuo sinulle sen kysymykset ja lupapyynnöt, kunnes lopetat sen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher sur %@ le fait avancer et vous transmet ses questions et ses autorisations, jusqu’à ce que vous l’arrêtiez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ पर Watcher इसे चालू रखता है और इसके सवाल और अनुमतियाँ आप तक लाता है, जब तक आप इसे न रोकें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A(z) %@ számítógépen futó Watcher továbbviszi, és eléd hozza a kérdéseit és engedélykéréseit, amíg le nem állítod."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher su %@ lo porta avanti e ti porta le sue domande e autorizzazioni, finché non lo fermi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停止するまで、%@ の Watcher がこのスレッドを進め続け、質問や許可をあなたに届けます。"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तुम्ही थांबवेपर्यंत %@ वरील Watcher तो चालू ठेवतो आणि त्याचे प्रश्न आणि परवानग्या तुमच्याकडे आणतो."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher på %@ holder den i gang og gir deg spørsmålene og tillatelsene dens, til du stopper den."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher op %@ houdt hem gaande en brengt je de vragen en toestemmingen ervan, tot je hem stopt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher na %@ podtrzymuje go i przekazuje ci jego pytania i pozwolenia, dopóki go nie zatrzymasz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Watcher em %@ a mantém em andamento e traz para você as perguntas e permissões dela, até você pará-lo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Watcher em %@ mantém-na a decorrer e traz-lhe as perguntas e permissões dela, até a parar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher pe %@ îl duce mai departe și îți aduce întrebările și permisiunile lui, până îl oprești."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher på %@ håller den igång och skickar dess frågor och behörigheter till dig, tills du stoppar den."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "நீங்கள் நிறுத்தும் வரை %@ இல் உள்ள Watcher இதைத் தொடர வைத்து, அதன் கேள்விகளையும் அனுமதிகளையும் உங்களிடம் கொண்டுவரும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@లోని Watcher మీరు ఆపే వరకు దీన్ని కొనసాగిస్తుంది, దాని ప్రశ్నలను, అనుమతులను మీకు తెస్తుంది."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ üzerindeki Watcher, siz durdurana kadar onu sürdürür, sorularını ve izinlerini size getirir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher на %@ продовжує його і приносить вам його питання й запити дозволу, доки ви його не зупините."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ پر Watcher اسے چلاتا رہتا ہے اور اس کے سوالات اور اجازتیں آپ تک لاتا ہے، جب تک آپ اسے نہ روکیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 上的 Watcher 会让它一直进行，并把它的问题和权限请求带给你，直到你停止它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 上的 Watcher 會讓它持續進行，並把它的問題和權限請求帶給你，直到你停止它。"
          }
        }
      }
    },
