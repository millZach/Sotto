        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’ultimo tentativo di Watcher alle %@ non l’ha raggiunto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher が %@ に試みた最後の送信は届きませんでした。"
