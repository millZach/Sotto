    "Each computer runs Sotto and shares its threads with this iPhone." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يشغّل كل كمبيوتر Sotto ويشارك محادثاته مع هذا الـ iPhone."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "প্রতিটি কম্পিউটারে Sotto চলে এবং এর থ্রেডগুলো এই iPhone-এর সাথে শেয়ার করে।"
          }
        },
        "cs" : {
          "stringUnit" : {
