        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher से अपने थ्रेड शुरू करने, उनकी जाँच करने या उन्हें रोकने को कहें। यह आपकी ओर से किसी चीज़ का जवाब नहीं देता।"
          }
        },
        "hu" : {
          "stringUnit" : {
