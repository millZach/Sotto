    "Check that it’s on and that Tailscale is connected on this iPhone." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحقق من أنه قيد التشغيل وأن Tailscale متصل على هذا الـ iPhone."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এটি চালু আছে কি না এবং এই iPhone-এ Tailscale সংযুক্ত আছে কি না দেখে নিন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zkontrolujte, že je zapnutý a že je na tomto iPhonu připojený Tailscale."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tjek, at den er tændt, og at Tailscale er forbundet på denne iPhone."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüfe, ob er eingeschaltet ist und Tailscale auf diesem iPhone verbunden ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ελέγξτε ότι είναι ενεργοποιημένος και ότι το Tailscale είναι συνδεδεμένο σε αυτό το iPhone."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check that it’s on and that Tailscale is connected on this iPhone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprueba que esté encendido y que Tailscale esté conectado en este iPhone."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifica que esté encendida y que Tailscale esté conectado en este iPhone."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
