        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overvåges af Watcher. Mens din egen omgang her kører, kan den kun styre den omgang."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Von Watcher beobachtet. Solange dein eigener Durchgang hier läuft, kann er diesen Durchgang nur steuern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το παρακολουθεί ο Watcher. Όσο εκτελείται εδώ ο δικός σας γύρος, μπορεί μόνο να καθοδηγήσει εκείνον τον γύρο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watched by Watcher. While your own turn here runs, it can only steer that turn."
