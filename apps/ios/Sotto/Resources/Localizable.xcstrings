    "A thread waiting on you still counts." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المحادثة التي تنتظرك تُحتسب أيضًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার অপেক্ষায় থাকা থ্রেডও গোনা হয়।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vlákno, které čeká na vás, se také počítá."
