        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই কম্পিউটারে কোনো প্রস্তুত মডেল নেই। ওখানে Sotto-তে একটি প্রোভাইডার সংযুক্ত করুন, তারপর আবার চেষ্টা করুন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
