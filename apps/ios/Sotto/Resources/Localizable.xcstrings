    "Whether this iPhone can answer questions and permissions is set in Sotto on each computer." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُضبط في Sotto على كل كمبيوتر ما إذا كان هذا الـ iPhone يستطيع الإجابة عن الأسئلة والأذونات."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই iPhone প্রশ্ন ও অনুমতির উত্তর দিতে পারবে কি না, তা প্রতিটি কম্পিউটারের Sotto-তে ঠিক করা হয়।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zda tento iPhone může odpovídat na otázky a povolení, se nastavuje v Sotto na každém počítači."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om denne iPhone må svare på spørgsmål og tilladelser, indstilles i Sotto på hver computer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ob dieses iPhone Fragen und Berechtigungen beantworten darf, legst du in Sotto auf jedem Computer fest."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το αν αυτό το iPhone μπορεί να απαντά σε ερωτήσεις και άδειες ορίζεται στο Sotto σε κάθε υπολογιστή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whether this iPhone can answer questions and permissions is set in Sotto on each computer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si este iPhone puede responder a preguntas y permisos se configura en Sotto en cada ordenador."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si este iPhone puede responder preguntas y permisos se configura en Sotto en cada computadora."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si este iPhone puede responder preguntas y permisos se configura en Sotto en cada computadora."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se, voiko tämä iPhone vastata kysymyksiin ja lupapyyntöihin, asetetaan Sottossa kussakin tietokoneessa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C’est dans Sotto, sur chaque ordinateur, que l’on choisit si cet iPhone peut répondre aux questions et aux autorisations."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह iPhone सवालों और अनुमतियों का जवाब दे सकता है या नहीं, यह हर कंप्यूटर पर Sotto में तय होता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Azt, hogy ez az iPhone válaszolhat-e kérdésekre és engedélykérésekre, az egyes számítógépeken a Sottóban lehet beállítani."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se questo iPhone può rispondere a domande e autorizzazioni si imposta in Sotto su ciascun computer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この iPhone から質問や許可に回答できるかどうかは、各コンピュータの Sotto で設定します。"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हा iPhone प्रश्नांना आणि परवानग्यांना उत्तर देऊ शकतो की नाही, हे प्रत्येक कॉम्प्युटरवरील Sotto मध्ये ठरवले जाते."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om denne iPhonen kan svare på spørsmål og tillatelser, stilles inn i Sotto på hver datamaskin."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Of deze iPhone vragen en toestemmingen mag beantwoorden, stel je in Sotto op elke computer in."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To, czy ten iPhone może odpowiadać na pytania i pozwolenia, ustawia się w Sotto na każdym komputerze."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se este iPhone pode responder a perguntas e permissões é definido no Sotto em cada computador."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se este iPhone pode responder a perguntas e permissões é definido no Sotto em cada computador."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dacă acest iPhone poate răspunde la întrebări și permisiuni se setează în Sotto pe fiecare computer."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om den här iPhone får svara på frågor och behörigheter ställs in i Sotto på varje dator."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இந்த iPhone கேள்விகளுக்கும் அனுமதிகளுக்கும் பதிலளிக்கலாமா என்பது ஒவ்வொரு கணினியிலும் உள்ள Sotto இல் அமைக்கப்படுகிறது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఈ iPhone ప్రశ్నలకు, అనుమతులకు సమాధానం ఇవ్వగలదా అనేది ప్రతి కంప్యూటర్‌లోని Sottoలో సెట్ అవుతుంది."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu iPhone’un soruları ve izinleri cevaplayıp cevaplayamayacağı her bilgisayardaki Sotto’da ayarlanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чи може цей iPhone відповідати на питання й запити дозволу, налаштовується в Sotto на кожному комп’ютері."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یہ iPhone سوالات اور اجازتوں کا جواب دے سکتا ہے یا نہیں، یہ ہر کمپیوٹر پر Sotto میں طے ہوتا ہے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此 iPhone 能否答复问题和权限请求，需在每台电脑上的 Sotto 中设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此 iPhone 能否答覆問題和權限請求，需在每部電腦上的 Sotto 中設定。"
          }
        }
      }
    },
