    "Update Sotto on %@ to send to Watcher while it works. Your message is still here." : {
      "comment" : "%@ is the computer's name",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حدّث Sotto على %@ لترسل إلى Watcher أثناء عمله. رسالتك لا تزال هنا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher কাজ করার সময় এতে পাঠাতে %@-এ Sotto আপডেট করুন। আপনার বার্তা এখনও এখানে আছে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chcete-li Watcherovi psát, zatímco pracuje, aktualizujte Sotto na %@. Vaše zpráva tu stále je."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opdater Sotto på %@ for at sende til Watcher, mens den arbejder. Din besked er her stadig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktualisiere Sotto auf %@, um an Watcher zu senden, während er arbeitet. Deine Nachricht ist noch da."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ενημερώστε το Sotto στον υπολογιστή %@ για να στέλνετε στον Watcher ενώ δουλεύει. Το μήνυμά σας είναι ακόμα εδώ."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Update Sotto on %@ to send to Watcher while it works. Your message is still here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actualiza Sotto en %@ para enviar mensajes a Watcher mientras trabaja. Tu mensaje sigue aquí."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actualiza Sotto en %@ para enviar mensajes a Watcher mientras trabaja. Tu mensaje sigue aquí."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actualiza Sotto en %@ para enviar mensajes a Watcher mientras trabaja. Tu mensaje sigue aquí."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Päivitä Sotto tietokoneella %@, niin voit lähettää Watcherille sen työskennellessä. Viestisi on yhä täällä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mettez à jour Sotto sur %@ pour envoyer des messages à Watcher pendant qu’il travaille. Votre message est toujours là."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "काम के दौरान Watcher को भेजने के लिए %@ पर Sotto अपडेट करें। आपका संदेश अभी भी यहीं है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frissítsd a Sottót a(z) %@ számítógépen, hogy munka közben is küldhess a Watchernek. Az üzeneted még itt van."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiorna Sotto su %@ per inviare messaggi a Watcher mentre lavora. Il tuo messaggio è ancora qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher の作業中に送信するには、%@ の Sotto をアップデートしてください。メッセージはここに残っています。"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher काम करत असताना त्याला पाठवण्यासाठी %@ वर Sotto अपडेट करा. तुमचा संदेश अजूनही इथेच आहे."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oppdater Sotto på %@ for å sende til Watcher mens den jobber. Meldingen din er fortsatt her."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Werk Sotto bij op %@ om naar Watcher te versturen terwijl hij bezig is. Je bericht staat er nog."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaktualizuj Sotto na %@, aby pisać do Watchera, gdy pracuje. Twoja wiadomość nadal tu jest."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atualize o Sotto em %@ para enviar ao Watcher enquanto ele trabalha. Sua mensagem continua aqui."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atualize o Sotto em %@ para enviar ao Watcher enquanto trabalha. A sua mensagem continua aqui."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actualizează Sotto pe %@ pentru a-i trimite lui Watcher cât lucrează. Mesajul tău e încă aici."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uppdatera Sotto på %@ för att skicka till Watcher medan den arbetar. Ditt meddelande finns kvar här."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher வேலை செய்யும்போது அதற்கு அனுப்ப %@ இல் Sotto ஐப் புதுப்பிக்கவும். உங்கள் செய்தி இன்னும் இங்கே உள்ளது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher పని చేస్తుండగా దానికి పంపడానికి %@లో Sottoను అప్‌డేట్ చేయండి. మీ సందేశం ఇంకా ఇక్కడే ఉంది."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher çalışırken ona göndermek için %@ üzerindeki Sotto’yu güncelleyin. Mesajınız hâlâ burada."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оновіть Sotto на %@, щоб надсилати повідомлення Watcher, поки він працює. Ваше повідомлення досі тут."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher کے کام کے دوران اسے بھیجنے کے لیے %@ پر Sotto اپ ڈیٹ کریں۔ آپ کا پیغام ابھی یہیں ہے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更新 %@ 上的 Sotto，即可在 Watcher 工作时向它发送消息。你的消息仍在这里。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
