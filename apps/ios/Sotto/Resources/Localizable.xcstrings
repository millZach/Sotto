          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcherin viimeisin yritys kello %@ ei päässyt perille."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La dernière tentative de Watcher à %@ ne l’a pas atteint."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ पर Watcher की पिछली कोशिश उस तक नहीं पहुँची।"
          }
        },
        "hu" : {
