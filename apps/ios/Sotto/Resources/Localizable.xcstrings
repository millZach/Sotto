        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tietokoneeseen %@ ei saada yhteyttä, joten pull requestia ei luettu. Yhdistä uudelleen ja yritä uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est injoignable, la pull request n’a donc pas été lue. Reconnectez-vous et réessayez."
