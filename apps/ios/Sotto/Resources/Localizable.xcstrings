    "Watcher didn’t confirm your message, so it’s back in the box. Check the conversation before you send it again." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يؤكد Watcher رسالتك، لذا أُعيدت إلى المربع. تحقق من الحوار قبل أن ترسلها مجددًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher আপনার বার্তা নিশ্চিত করেনি, তাই এটি বক্সে ফিরে এসেছে। আবার পাঠানোর আগে কথোপকথনটি দেখে নিন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher vaši zprávu nepotvrdil, takže je zpět v poli. Než ji pošlete znovu, zkontrolujte konverzaci."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher bekræftede ikke din besked, så den er tilbage i feltet. Tjek samtalen, før du sender den igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher hat deine Nachricht nicht bestätigt, daher steht sie wieder im Feld. Prüfe die Unterhaltung, bevor du sie erneut sendest."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο Watcher δεν επιβεβαίωσε το μήνυμά σας, οπότε επέστρεψε στο πλαίσιο. Ελέγξτε τη συζήτηση πριν το στείλετε ξανά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher didn’t confirm your message, so it’s back in the box. Check the conversation before you send it again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher no ha confirmado tu mensaje, así que ha vuelto al cuadro. Revisa la conversación antes de volver a enviarlo."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher no confirmó tu mensaje, así que volvió al cuadro. Revisa la conversación antes de volver a enviarlo."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher no confirmó tu mensaje, así que volvió al cuadro. Revisa la conversación antes de volver a enviarlo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher ei vahvistanut viestiäsi, joten se palautettiin kenttään. Tarkista keskustelu ennen kuin lähetät sen uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher n’a pas confirmé votre message, il est donc de retour dans la zone de saisie. Vérifiez la conversation avant de le renvoyer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher ने आपके संदेश की पुष्टि नहीं की, इसलिए वह वापस बॉक्स में है। दोबारा भेजने से पहले बातचीत जाँच लें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Watcher nem erősítette meg az üzenetedet, ezért visszakerült a mezőbe. Nézd meg a beszélgetést, mielőtt újra elküldöd."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher non ha confermato il tuo messaggio, quindi è di nuovo nella casella di testo. Controlla la conversazione prima di inviarlo di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher がメッセージを確認しなかったため、入力欄に戻しました。もう一度送信する前に会話を確認してください。"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher ने तुमच्या संदेशाची पुष्टी केली नाही, म्हणून तो पुन्हा बॉक्समध्ये आहे. पुन्हा पाठवण्याआधी संभाषण तपासा."
