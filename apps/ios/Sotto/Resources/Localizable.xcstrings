          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "削除すると、接続できる場合は %@ 側でもこの iPhone の登録が解除されます。スレッドはコンピュータに残ります。"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तो काढल्यावर, पोहोचता आल्यास %@ सुद्धा हा iPhone विसरतो. थ्रेड कॉम्प्युटरवरच राहतात."
