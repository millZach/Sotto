    "Your reply to a thread on %@ wasn’t queued. Its text is back in that thread." : {
      "comment" : "%@ is the computer's name",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يُضَف ردك على محادثة على %@ إلى قائمة الانتظار. عاد نصه إلى تلك المحادثة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@-এ একটি থ্রেডে আপনার রিপ্লাই সারিতে রাখা হয়নি। এর লেখা ওই থ্রেডে ফিরে গেছে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaše zpráva do vlákna na %@ nebyla zařazena do fronty. Její text je zpět v tom vlákně."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit svar til en tråd på %@ blev ikke sat i kø. Teksten er tilbage i den tråd."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Antwort an einen Thread auf %@ wurde nicht eingereiht. Der Text steht wieder in diesem Thread."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η απάντησή σας σε ένα νήμα στον υπολογιστή %@ δεν μπήκε στην ουρά. Το κείμενό της επέστρεψε σε εκείνο το νήμα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your reply to a thread on %@ wasn’t queued. Its text is back in that thread."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu respuesta a un hilo en %@ no se ha puesto en cola. Su texto ha vuelto a ese hilo."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu respuesta a un hilo en %@ no se puso en cola. Su texto volvió a ese hilo."
