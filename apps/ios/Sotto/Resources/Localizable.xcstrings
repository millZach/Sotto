          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watchers siste forsøk kl. %@ nådde ikke fram."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De laatste poging van Watcher om %@ kwam niet aan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ostatnia próba Watchera o %@ nie dotarła."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A última tentativa do Watcher, às %@, não chegou."
