    "Sends this message now instead of after the turn." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يرسل هذه الرسالة الآن بدلًا من انتظار نهاية الدور."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "টার্নের পরে না পাঠিয়ে এই বার্তাটি এখনই পাঠায়।"
          }
