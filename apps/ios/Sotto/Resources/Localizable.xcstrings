    "Sotto can’t reach %@ now. Nothing changed." : {
      "comment" : "%@ is the computer's name",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يستطيع Sotto الوصول إلى %@ الآن. لم يتغيّر شيء."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sotto এখন %@-এ পৌঁছাতে পারছে না। কিছুই বদলায়নি।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sotto se teď nemůže spojit s %@. Nic se nezměnilo."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sotto kan ikke nå %@ lige nu. Intet blev ændret."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sotto kann %@ gerade nicht erreichen. Nichts wurde geändert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Sotto δεν μπορεί να συνδεθεί τώρα με τον υπολογιστή %@. Δεν άλλαξε τίποτα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sotto can’t reach %@ now. Nothing changed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sotto no puede conectarse con %@ ahora. No ha cambiado nada."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sotto no puede conectarse con %@ ahora. No cambió nada."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sotto no puede conectarse con %@ ahora. No cambió nada."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sotto ei saa nyt yhteyttä tietokoneeseen %@. Mitään ei muutettu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sotto ne peut pas joindre %@ pour l’instant. Rien n’a changé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sotto अभी %@ तक नहीं पहुँच सकता। कुछ नहीं बदला।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Sotto most nem éri el a(z) %@ számítógépet. Semmi sem változott."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sotto non riesce a raggiungere %@ ora. Non è cambiato nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在 Sotto から %@ に接続できません。何も変更されていません。"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sotto आत्ता %@ पर्यंत पोहोचू शकत नाही. काहीही बदलले नाही."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sotto når ikke %@ nå. Ingenting ble endret."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sotto kan %@ nu niet bereiken. Er is niets gewijzigd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sotto nie może teraz połączyć się z %@. Nic się nie zmieniło."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Sotto não consegue acessar %@ agora. Nada mudou."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Sotto não consegue contactar %@ neste momento. Nada mudou."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sotto nu poate contacta %@ acum. Nu s-a schimbat nimic."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sotto kan inte nå %@ just nu. Inget ändrades."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sotto ஆல் இப்போது %@ ஐ அணுக முடியவில்லை. எதுவும் மாறவில்லை."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sotto ఇప్పుడు %@ను చేరుకోలేదు. ఏదీ మారలేదు."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sotto şu anda %@ bilgisayarına ulaşamıyor. Hiçbir şey değişmedi."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sotto зараз не може зв’язатися з %@. Нічого не змінилося."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sotto ابھی %@ تک نہیں پہنچ سکتا۔ کچھ نہیں بدلا۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sotto 现在无法连接到 %@。没有任何更改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sotto 目前無法連線到 %@。沒有任何變更。"
          }
        }
      }
    },
    "Sotto can’t use the camera. Turn it on in Settings › Sotto › Camera." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يستطيع Sotto استخدام الكاميرا. فعّلها من الإعدادات › Sotto › الكاميرا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sotto ক্যামেরা ব্যবহার করতে পারছে না। সেটিংস › Sotto › ক্যামেরা-তে এটি চালু করুন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sotto nemůže používat fotoaparát. Zapněte ho v Nastavení › Sotto › Fotoaparát."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sotto kan ikke bruge kameraet. Slå det til i Indstillinger › Sotto › Kamera."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sotto kann die Kamera nicht verwenden. Aktiviere sie unter Einstellungen › Sotto › Kamera."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Sotto δεν μπορεί να χρησιμοποιήσει την κάμερα. Ενεργοποιήστε την στις Ρυθμίσεις › Sotto › Κάμερα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sotto can’t use the camera. Turn it on in Settings › Sotto › Camera."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sotto no puede usar la cámara. Actívala en Ajustes › Sotto › Cámara."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sotto no puede usar la cámara. Actívala en Configuración › Sotto › Cámara."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sotto no puede usar la cámara. Actívala en Configuración › Sotto › Cámara."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sotto ei voi käyttää kameraa. Ota se käyttöön kohdassa Asetukset › Sotto › Kamera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sotto ne peut pas utiliser l’appareil photo. Activez-le dans Réglages › Sotto › Appareil photo."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sotto कैमरा इस्तेमाल नहीं कर सकता। इसे सेटिंग्ज़ › Sotto › कैमरा में चालू करें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Sotto nem használhatja a kamerát. Kapcsold be itt: Beállítások › Sotto › Kamera."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sotto non può usare la fotocamera. Attivala in Impostazioni › Sotto › Fotocamera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sotto はカメラを使用できません。「設定 › Sotto › カメラ」でオンにしてください。"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sotto कॅमेरा वापरू शकत नाही. तो सेटिंग्ज › Sotto › कॅमेरा मध्ये चालू करा."
