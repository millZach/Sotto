    "Resume Watcher’s queue in Sotto on %@, or remove it." : {
      "comment" : "%@ is the computer's name",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استأنف قائمة انتظار Watcher في Sotto على %@، أو أزِلها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@-এ Sotto-তে Watcher-এর সারি আবার চালু করুন, অথবা এটি সরান।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obnovte frontu Watchera v Sotto na %@, nebo ji odstraňte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genoptag Watchers kø i Sotto på %@, eller fjern den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setze die Warteschlange von Watcher in Sotto auf %@ fort oder entferne die Nachricht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
