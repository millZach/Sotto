        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher 未確認你的訊息。由於輸入框中已有較新的文字，訊息保留在交談內容下方。再次傳送前，請先查看交談內容。"
          }
        }
      }
    },
    "Watcher had no threads to stop. Nothing was stopped." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
