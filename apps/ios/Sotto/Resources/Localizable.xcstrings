    "Alerts arrive only while Sotto is open on this iPhone." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تصل التنبيهات فقط عندما يكون Sotto مفتوحًا على هذا الـ iPhone."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sotto এই iPhone-এ খোলা থাকলেই শুধু সতর্কবার্তা আসে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upozornění přicházejí, jen když je Sotto na tomto iPhonu otevřené."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notifikationer kommer kun, mens Sotto er åben på denne iPhone."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mitteilungen kommen nur an, während Sotto auf diesem iPhone geöffnet ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι ειδοποιήσεις φτάνουν μόνο όσο το Sotto είναι ανοιχτό σε αυτό το iPhone."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alerts arrive only while Sotto is open on this iPhone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las alertas solo llegan mientras Sotto está abierto en este iPhone."
          }
        },
