          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher no se está ejecutando en %@. Inícialo en Sotto en %@ y luego pregúntale aquí."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher no se está ejecutando en %@. Inícialo en Sotto en %@ y luego pregúntale aquí."
