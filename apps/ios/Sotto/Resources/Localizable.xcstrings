    "Ask Watcher to start, check on or stop your threads. It answers nothing for you." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اطلب من Watcher بدء محادثاتك أو تفقدها أو إيقافها. لا يجيب عن أي شيء نيابة عنك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher-কে আপনার থ্রেড শুরু করতে, খোঁজ নিতে বা থামাতে বলুন। এটি আপনার হয়ে কোনো উত্তর দেয় না।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Požádejte Watchera, ať spustí, zkontroluje nebo zastaví vaše vlákna. Za vás na nic neodpovídá."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bed Watcher om at starte, tjekke eller stoppe dine tråde. Den svarer ikke på noget for dig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitte Watcher, deine Threads zu starten, zu prüfen oder zu stoppen. Er beantwortet nichts für dich."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ζητήστε από τον Watcher να ξεκινήσει, να ελέγξει ή να σταματήσει τα νήματά σας. Δεν απαντά σε τίποτα για λογαριασμό σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ask Watcher to start, check on or stop your threads. It answers nothing for you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pide a Watcher que inicie, revise o detenga tus hilos. No responde nada por ti."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
