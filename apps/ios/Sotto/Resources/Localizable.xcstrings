          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ वरील एका थ्रेडला दिलेला तुमचा रिप्लाय रांगेत लागला नाही. त्याचा मजकूर त्या थ्रेडमध्ये परत आहे."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
