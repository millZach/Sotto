        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тема забарвлює світло вгорі кожного екрана, те, що працює, і те, чого можна торкнутися."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تھیم ہر اسکرین کے اوپر کی روشنی، جو کام چل رہا ہے اور جن چیزوں پر آپ ٹیپ کر سکتے ہیں، ان کا رنگ طے کرتی ہے۔"
