          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ নিশ্চিত করেনি যে আপনার বার্তা সরানো হয়েছে। আবার পাঠানোর আগে Watcher-এর কথোপকথন দেখে নিন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ nepotvrdil, že vaše zpráva byla odstraněna. Než ji pošlete znovu, zkontrolujte konverzaci s Watcherem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ bekræftede ikke, at din besked blev fjernet. Tjek Watchers samtale, før du sender den igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat nicht bestätigt, dass deine Nachricht entfernt wurde. Prüfe die Unterhaltung mit Watcher, bevor du sie erneut sendest."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο υπολογιστής %@ δεν επιβεβαίωσε ότι το μήνυμά σας αφαιρέθηκε. Ελέγξτε τη συζήτηση του Watcher πριν το στείλετε ξανά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
