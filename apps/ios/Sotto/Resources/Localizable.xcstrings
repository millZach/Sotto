    "Removing it forgets this iPhone on %@ too, when it can be reached. Threads stay on the computer." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند الإزالة ينسى %@ هذا الـ iPhone أيضًا، متى أمكن الوصول إليه. تبقى المحادثات على الكمبيوتر."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সরালে, পৌঁছানো গেলে %@-ও এই iPhone-কে ভুলে যাবে। থ্রেডগুলো কম্পিউটারেই থাকবে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po odstranění na tento iPhone zapomene i %@, pokud se s ním dá spojit. Vlákna zůstanou na počítači."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du fjerner den, glemmer %@ også denne iPhone, hvis computeren kan nås. Trådene bliver på computeren."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Entfernen vergisst auch %@ dieses iPhone, sofern der Computer erreichbar ist. Threads bleiben auf dem Computer."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Με την αφαίρεση, ο υπολογιστής %@ ξεχνά επίσης αυτό το iPhone, εφόσον είναι προσβάσιμος. Τα νήματα παραμένουν στον υπολογιστή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Removing it forgets this iPhone on %@ too, when it can be reached. Threads stay on the computer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al eliminarlo, %@ también olvidará este iPhone cuando haya conexión. Los hilos se quedan en el ordenador."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
