          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ پر Sotto میں Watcher کی قطار دوبارہ شروع کریں، یا اسے ہٹائیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在 %@ 上的 Sotto 中恢复 Watcher 的队列，或移除它。"
          }
