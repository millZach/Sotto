    "Removed %@ from this iPhone, but couldn’t confirm removal there, so it may still list this iPhone." : {
      "comment" : "%@ is the computer's name",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تمت إزالة %@ من هذا الـ iPhone، لكن تعذّر تأكيد الإزالة هناك، لذا قد يظل يُدرج هذا الـ iPhone."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই iPhone থেকে %@ সরানো হয়েছে, কিন্তু ওখানে সরানো নিশ্চিত করা যায়নি, তাই এটি হয়তো এখনও এই iPhone-কে তালিকায় দেখায়।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Počítač %@ byl z tohoto iPhonu odstraněn, ale odstranění se tam nepodařilo potvrdit, takže tento iPhone může mít dál v seznamu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
