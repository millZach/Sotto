    "%@ stays on %@ until it confirms." : {
      "comment" : "The first %@ is the provider's name, such as Claude Code; the second is a permission mode's name, such as Allow edits",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبقى %@ على «%@» حتى يؤكد."
