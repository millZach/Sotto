    "Each stays watched until you stop it." : {
      "comment" : "Said of several watched threads",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبقى كل منها مُراقَبة حتى توقفها."
