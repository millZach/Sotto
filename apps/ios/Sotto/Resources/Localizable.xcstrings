    "%@ didn’t confirm that your message was removed. Check Watcher’s conversation before you send it again." : {
      "comment" : "%@ is the computer's name",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
