        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसे हटाने पर, पहुँच होने पर %@ भी इस iPhone को भूल जाता है। थ्रेड कंप्यूटर पर बने रहते हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
