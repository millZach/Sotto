    "A photo couldn’t reach %@, so nothing was sent. Try again when it’s connected." : {
      "comment" : "%@ is the computer's name",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر وصول صورة إلى %@، لذا لم يُرسَل شيء. حاول مرة أخرى عند اتصاله."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "একটি ছবি %@-এ পৌঁছায়নি, তাই কিছুই পাঠানো হয়নি। এটি সংযুক্ত হলে আবার চেষ্টা করুন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotku se nepodařilo přenést na %@, takže nic nebylo odesláno. Zkuste to znovu, až bude připojen."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et billede kunne ikke nå %@, så intet blev sendt. Prøv igen, når computeren er forbundet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Foto hat %@ nicht erreicht, daher wurde nichts gesendet. Versuch es erneut, wenn der Computer verbunden ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μια φωτογραφία δεν έφτασε στον υπολογιστή %@, οπότε δεν στάλθηκε τίποτα. Δοκιμάστε ξανά όταν είναι συνδεδεμένος."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A photo couldn’t reach %@, so nothing was sent. Try again when it’s connected."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una foto no ha podido llegar a %@, así que no se ha enviado nada. Inténtalo de nuevo cuando haya conexión."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una foto no pudo llegar a %@, así que no se envió nada. Inténtalo de nuevo cuando haya conexión."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una foto no pudo llegar a %@, así que no se envió nada. Inténtalo de nuevo cuando haya conexión."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuva ei päässyt tietokoneelle %@, joten mitään ei lähetetty. Yritä uudelleen, kun se on yhdistettynä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une photo n’a pas pu parvenir à %@, rien n’a donc été envoyé. Réessayez quand il sera connecté."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक फ़ोटो %@ तक नहीं पहुँच सकी, इसलिए कुछ नहीं भेजा गया। कनेक्ट होने पर फिर से कोशिश करें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egy fotó nem jutott el a(z) %@ számítógépre, ezért semmi sem ment el. Próbáld újra, ha csatlakozik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una foto non è riuscita a raggiungere %@, quindi non è stato inviato nulla. Riprova quando è connesso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写真を %@ に送れなかったため、何も送信されていません。接続されたらもう一度お試しください。"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक फोटो %@ पर्यंत पोहोचला नाही, त्यामुळे काहीही पाठवले नाही. तो कनेक्ट झाल्यावर पुन्हा प्रयत्न करा."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et bilde kom ikke fram til %@, så ingenting ble sendt. Prøv igjen når den er tilkoblet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een foto kon %@ niet bereiken, dus er is niets verstuurd. Probeer opnieuw als de computer verbonden is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zdjęcie nie dotarło do %@, więc nic nie zostało wysłane. Spróbuj ponownie, gdy komputer będzie połączony."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma foto não chegou a %@, então nada foi enviado. Tente novamente quando ele estiver conectado."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma fotografia não conseguiu chegar a %@, por isso nada foi enviado. Tente novamente quando estiver ligado."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O fotografie nu a putut ajunge la %@, așa că nu s-a trimis nimic. Încearcă din nou când e conectat."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En bild kunde inte nå %@, så inget skickades. Försök igen när datorn är ansluten."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ஒரு படம் %@ ஐச் சென்றடையவில்லை, எனவே எதுவும் அனுப்பப்படவில்லை. அது இணைக்கப்பட்டதும் மீண்டும் முயலவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఒక ఫోటో %@ను చేరలేకపోయింది, కాబట్టి ఏదీ పంపలేదు. అది కనెక్ట్ అయినప్పుడు మళ్లీ ప్రయత్నించండి."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir fotoğraf %@ bilgisayarına ulaşamadı, bu yüzden hiçbir şey gönderilmedi. Bağlandığında yeniden deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фото не вдалося передати на %@, тож нічого не надіслано. Спробуйте ще раз, коли він буде на зв’язку."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ایک تصویر %@ تک نہیں پہنچ سکی، اس لیے کچھ نہیں بھیجا گیا۔ کنیکٹ ہونے پر دوبارہ کوشش کریں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有一张照片无法送达 %@，因此未发送任何内容。连接后请重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
