    "Only the first 1,000 folders are listed. Enter a full path to open another." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُدرَج أول 1000 مجلد فقط. أدخل مسارًا كاملًا لفتح مجلد آخر."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "শুধু প্রথম ১,০০০টি ফোল্ডার তালিকায় আছে। অন্য একটি খুলতে পুরো পাথ লিখুন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobrazuje se jen prvních 1000 složek. Chcete-li otevřít jinou, zadejte úplnou cestu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun de første 1.000 mapper vises. Angiv en fuld sti for at åbne en anden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur die ersten 1.000 Ordner werden angezeigt. Gib einen vollständigen Pfad ein, um einen anderen zu öffnen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εμφανίζονται μόνο οι πρώτοι 1.000 φάκελοι. Εισαγάγετε πλήρη διαδρομή για να ανοίξετε άλλον."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only the first 1,000 folders are listed. Enter a full path to open another."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se muestran las primeras 1000 carpetas. Introduce una ruta completa para abrir otra."
