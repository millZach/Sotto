    "Every thread this iPhone can reach is watched already, or settled." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كل محادثة يصل إليها هذا الـ iPhone مُراقَبة بالفعل، أو مُنحّاة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই iPhone যে থ্রেডগুলোতে পৌঁছাতে পারে, সেগুলোর প্রতিটি ইতিমধ্যে নজরে আছে অথবা সরিয়ে রাখা।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Každé vlákno, na které tento iPhone dosáhne, je už sledované nebo odložené."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle tråde, denne iPhone kan nå, er allerede overvåget eller lagt til side."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder Thread, den dieses iPhone erreichen kann, wird schon beobachtet oder ist abgelegt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάθε νήμα στο οποίο έχει πρόσβαση αυτό το iPhone παρακολουθείται ήδη ή είναι παραμερισμένο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every thread this iPhone can reach is watched already, or settled."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos los hilos a los que este iPhone puede acceder ya están vigilados o apartados."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos los hilos a los que este iPhone puede acceder ya están vigilados o apartados."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos los hilos a los que este iPhone puede acceder ya están vigilados o apartados."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaikki ketjut, jotka tämä iPhone tavoittaa, ovat jo valvonnassa tai siirretty sivuun."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tous les fils que cet iPhone peut joindre sont déjà surveillés ou mis de côté."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस iPhone की पहुँच वाला हर थ्रेड पहले से निगरानी में है, या निपटाया जा चुका है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minden szál, amelyet ez az iPhone elér, már figyelt vagy félretett."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni thread che questo iPhone può raggiungere è già monitorato o accantonato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この iPhone から接続できるスレッドは、すべて見守り中か片付け済みです。"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हा iPhone पोहोचू शकणाऱ्या प्रत्येक थ्रेडवर आधीच लक्ष आहे, किंवा तो बाजूला ठेवलेला आहे."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle tråder denne iPhonen kan nå, er allerede overvåket eller lagt bort."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke thread die deze iPhone kan bereiken, wordt al gevolgd of is afgehandeld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każdy wątek, do którego ten iPhone ma dostęp, jest już obserwowany albo odłożony."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas as conversas que este iPhone acessa já estão vigiadas ou guardadas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas as conversas que este iPhone consegue contactar já estão vigiadas ou arrumadas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fiecare fir la care are acces acest iPhone e deja urmărit sau pus deoparte."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alla trådar som den här iPhone kan nå är redan bevakade eller undanlagda."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இந்த iPhone அணுகக்கூடிய ஒவ்வொரு த்ரெட்டும் ஏற்கனவே கவனிக்கப்படுகிறது, அல்லது ஒதுக்கி வைக்கப்பட்டுள்ளது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఈ iPhone చేరుకోగల ప్రతి థ్రెడ్ ఇప్పటికే గమనించబడుతోంది, లేదా పక్కన పెట్టబడింది."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu iPhone’un ulaşabildiği her sohbet zaten izleniyor ya da kenara alınmış."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кожен тред, до якого цей iPhone має доступ, уже відстежується або відкладений."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ہر وہ تھریڈ جس تک یہ iPhone پہنچ سکتا ہے، پہلے سے زیر نگرانی ہے یا ایک طرف رکھا گیا ہے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
