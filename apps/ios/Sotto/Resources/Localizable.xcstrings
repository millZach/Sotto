        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα νήματα που ξεκινήσατε ή αναλάβατε συνεχίζουν, όπως και ο Watcher."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
