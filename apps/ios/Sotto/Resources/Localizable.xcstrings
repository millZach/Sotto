    "Folder browsing is unavailable. Reconnect or update Sotto on this computer." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تصفح المجلدات غير متاح. أعد الاتصال أو حدّث Sotto على هذا الكمبيوتر."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ফোল্ডার ব্রাউজ করা যাচ্ছে না। আবার সংযোগ করুন অথবা এই কম্পিউটারে Sotto আপডেট করুন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
