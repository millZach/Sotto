    "Watcher asks each time. It can’t be given lasting permission." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يسأل Watcher في كل مرة. لا يمكن منحه إذنًا دائمًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher প্রতিবার জিজ্ঞাসা করে। একে স্থায়ী অনুমতি দেওয়া যায় না।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher se ptá pokaždé. Trvalé povolení mu dát nelze."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher spørger hver gang. Den kan ikke få varig tilladelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher fragt jedes Mal. Er kann keine dauerhafte Berechtigung erhalten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο Watcher ρωτά κάθε φορά. Δεν μπορεί να του δοθεί μόνιμη άδεια."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher asks each time. It can’t be given lasting permission."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher pregunta cada vez. No se le puede dar un permiso permanente."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher pregunta cada vez. No se le puede dar un permiso permanente."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher pregunta cada vez. No se le puede dar un permiso permanente."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher kysyy joka kerta. Sille ei voi antaa pysyvää lupaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher demande à chaque fois. Il ne peut pas recevoir d’autorisation durable."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher हर बार पूछता है। इसे स्थायी अनुमति नहीं दी जा सकती।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Watcher minden alkalommal kérdez. Nem kaphat tartós engedélyt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher chiede ogni volta. Non può ricevere un’autorizzazione permanente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher は毎回確認を求めます。継続的な許可を与えることはできません。"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher प्रत्येक वेळी विचारतो. त्याला कायमची परवानगी देता येत नाही."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher spør hver gang. Den kan ikke få varig tillatelse."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher vraagt het elke keer. Watcher kan geen blijvende toestemming krijgen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher pyta za każdym razem. Nie można mu dać stałego pozwolenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Watcher pergunta toda vez. Não é possível dar a ele uma permissão permanente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Watcher pergunta sempre. Não lhe pode ser dada uma permissão duradoura."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher întreabă de fiecare dată. Nu i se poate da o permisiune permanentă."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher frågar varje gång. Den kan inte få varaktig behörighet."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher ஒவ்வொரு முறையும் கேட்கும். இதற்கு நிலையான அனுமதி வழங்க முடியாது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher ప్రతిసారీ అడుగుతుంది. దీనికి శాశ్వత అనుమతి ఇవ్వలేము."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher her seferinde sorar. Ona kalıcı izin verilemez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher питає щоразу. Йому не можна дати постійний дозвіл."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher ہر بار پوچھتا ہے۔ اسے مستقل اجازت نہیں دی جا سکتی۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher 每次都会询问。无法给予它持久的权限。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher 每次都會詢問。無法給予它持久的權限。"
          }
        }
      }
    },
    "Watcher can’t take messages on this iPhone now, so what you shared goes in a new thread." : {
      "comment" : "Shown on the New thread sheet when something was shared to Sotto and no computer's Watcher can take it",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يستطيع Watcher استقبال الرسائل على هذا الـ iPhone الآن، لذا ستذهب مشاركتك إلى محادثة جديدة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher এখন এই iPhone-এ বার্তা নিতে পারছে না, তাই আপনি যা শেয়ার করেছেন তা একটি নতুন থ্রেডে যাবে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher teď na tomto iPhonu nemůže přijímat zprávy, takže to, co jste sdíleli, půjde do nového vlákna."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher kan ikke tage imod beskeder på denne iPhone lige nu, så det, du delte, kommer i en ny tråd."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher kann auf diesem iPhone gerade keine Nachrichten annehmen, daher kommt das Geteilte in einen neuen Thread."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Watcher δεν μπορεί να δεχτεί μηνύματα σε αυτό το iPhone τώρα, οπότε ό,τι μοιραστήκατε πηγαίνει σε νέο νήμα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher can’t take messages on this iPhone now, so what you shared goes in a new thread."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher no puede recibir mensajes en este iPhone ahora, así que lo que has compartido irá a un hilo nuevo."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher no puede recibir mensajes en este iPhone ahora, así que lo que compartiste irá a un hilo nuevo."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher no puede recibir mensajes en este iPhone ahora, así que lo que compartiste irá a un hilo nuevo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher ei voi nyt ottaa viestejä vastaan tässä iPhonessa, joten jakamasi menee uuteen ketjuun."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher ne peut pas recevoir de messages sur cet iPhone pour l’instant : ce que vous avez partagé ira dans un nouveau fil."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher अभी इस iPhone पर संदेश नहीं ले सकता, इसलिए आपने जो शेयर किया वह नए थ्रेड में जाएगा।"
          }
        },
