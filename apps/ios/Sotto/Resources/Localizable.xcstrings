    "Secure connection details could not be read. Unlock this iPhone and return to Sotto." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّرت قراءة تفاصيل الاتصال الآمن. افتح قفل هذا الـ iPhone وعُد إلى Sotto."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "নিরাপদ সংযোগের তথ্য পড়া যায়নি। এই iPhone আনলক করে Sotto-তে ফিরে আসুন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Údaje zabezpečeného připojení se nepodařilo načíst. Odemkněte iPhone a vraťte se do Sotto."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oplysningerne om den sikre forbindelse kunne ikke læses. Lås denne iPhone op, og vend tilbage til Sotto."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Daten für die sichere Verbindung konnten nicht gelesen werden. Entsperre dieses iPhone und kehre zu Sotto zurück."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν ήταν δυνατή η ανάγνωση των στοιχείων ασφαλούς σύνδεσης. Ξεκλειδώστε αυτό το iPhone και επιστρέψτε στο Sotto."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Secure connection details could not be read. Unlock this iPhone and return to Sotto."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se han podido leer los datos de la conexión segura. Desbloquea este iPhone y vuelve a Sotto."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudieron leer los datos de la conexión segura. Desbloquea este iPhone y vuelve a Sotto."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudieron leer los datos de la conexión segura. Desbloquea este iPhone y vuelve a Sotto."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suojatun yhteyden tietoja ei voitu lukea. Avaa tämän iPhonen lukitus ja palaa Sottoon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de lire les informations de connexion sécurisée. Déverrouillez cet iPhone et revenez dans Sotto."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सुरक्षित कनेक्शन की जानकारी नहीं पढ़ी जा सकी। इस iPhone को अनलॉक करें और Sotto पर लौटें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A biztonságos kapcsolat adatai nem olvashatók be. Oldd fel ezt az iPhone-t, és térj vissza a Sottóba."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile leggere i dettagli della connessione sicura. Sblocca questo iPhone e torna a Sotto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安全な接続の情報を読み込めませんでした。この iPhone のロックを解除して、Sotto に戻ってください。"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सुरक्षित कनेक्शनचे तपशील वाचता आले नाहीत. हा iPhone अनलॉक करा आणि Sotto वर परत या."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke lese detaljene for den sikre tilkoblingen. Lås opp denne iPhonen og gå tilbake til Sotto."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gegevens voor de beveiligde verbinding kunnen niet worden gelezen. Ontgrendel deze iPhone en ga terug naar Sotto."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się odczytać danych bezpiecznego połączenia. Odblokuj iPhone’a i wróć do Sotto."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível ler os dados da conexão segura. Desbloqueie este iPhone e volte ao Sotto."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível ler os dados da ligação segura. Desbloqueie este iPhone e volte ao Sotto."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detaliile conexiunii securizate nu au putut fi citite. Deblochează acest iPhone și revino în Sotto."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uppgifterna för den säkra anslutningen kunde inte läsas. Lås upp den här iPhone och gå tillbaka till Sotto."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "பாதுகாப்பான இணைப்பு விவரங்களைப் படிக்க முடியவில்லை. இந்த iPhone ஐ அன்லாக் செய்து Sotto க்குத் திரும்பவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "సురక్షిత కనెక్షన్ వివరాలను చదవలేకపోయింది. ఈ iPhoneను అన్‌లాక్ చేసి Sottoకు తిరిగి రండి."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Güvenli bağlantı bilgileri okunamadı. Bu iPhone’un kilidini açın ve Sotto’ya dönün."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не вдалося прочитати дані захищеного з’єднання. Розблокуйте цей iPhone і поверніться в Sotto."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "محفوظ کنکشن کی تفصیلات پڑھی نہیں جا سکیں۔ یہ iPhone ان لاک کریں اور Sotto پر واپس آئیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法读取安全连接信息。请解锁此 iPhone 并返回 Sotto。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法讀取安全連線資訊。請解鎖此 iPhone 並回到 Sotto。"
          }
        }
      }
    },
