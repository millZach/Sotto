            "state" : "translated",
            "value" : "নিশ্চিত না করা পর্যন্ত %1$@ “%2$@”-এ থাকবে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ zůstává v režimu %@, dokud to nepotvrdí."
          }
        },
