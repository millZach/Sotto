          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli avvisi arrivano solo mentre Sotto è aperto su questo iPhone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通知は、この iPhone で Sotto が開いている間だけ届きます。"
