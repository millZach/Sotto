    "These are kept on this iPhone. They don’t change any computer’s settings." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُحفظ هذه على هذا الـ iPhone، ولا تغيّر إعدادات أي كمبيوتر."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এগুলো এই iPhone-এ রাখা থাকে। এগুলো কোনো কম্পিউটারের সেটিংস বদলায় না।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tato nastavení se ukládají v tomto iPhonu. Nemění nastavení žádného počítače."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disse gemmes på denne iPhone. De ændrer ikke indstillingerne på nogen computer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Einstellungen bleiben auf diesem iPhone. Sie ändern nichts an den Einstellungen eines Computers."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτές διατηρούνται σε αυτό το iPhone. Δεν αλλάζουν τις ρυθμίσεις κανενός υπολογιστή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These are kept on this iPhone. They don’t change any computer’s settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se guardan en este iPhone. No cambian los ajustes de ningún ordenador."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se guardan en este iPhone. No cambian la configuración de ninguna computadora."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se guardan en este iPhone. No cambian la configuración de ninguna computadora."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nämä säilytetään tässä iPhonessa. Ne eivät muuta minkään tietokoneen asetuksia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces réglages sont conservés sur cet iPhone. Ils ne modifient les réglages d’aucun ordinateur."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ये इस iPhone पर रखे जाते हैं। ये किसी कंप्यूटर की सेटिंग्ज़ नहीं बदलते।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ezek ezen az iPhone-on maradnak. Egyik számítógép beállításait sem módosítják."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Queste impostazioni restano su questo iPhone. Non modificano le impostazioni di alcun computer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらはこの iPhone に保存されます。コンピュータの設定は変わりません。"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हे या iPhone वर ठेवले जातात. ते कोणत्याही कॉम्प्युटरची सेटिंग्ज बदलत नाहीत."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disse lagres på denne iPhonen. De endrer ikke innstillingene på noen datamaskin."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze worden op deze iPhone bewaard. Ze wijzigen geen instellingen van een computer."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te ustawienia są zapisane na tym iPhonie. Nie zmieniają ustawień żadnego komputera."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estes ajustes ficam neste iPhone. Eles não mudam os ajustes de nenhum computador."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas opções ficam neste iPhone. Não alteram as definições de nenhum computador."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acestea sunt păstrate pe acest iPhone. Nu schimbă configurările niciunui computer."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De här sparas på den här iPhone. De ändrar inga inställningar på någon dator."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இவை இந்த iPhone இல் மட்டுமே வைக்கப்படுகின்றன. இவை எந்தக் கணினியின் அமைப்புகளையும் மாற்றாது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఇవి ఈ iPhoneలోనే ఉంచబడతాయి. ఇవి ఏ కంప్యూటర్ సెట్టింగ్‌లనూ మార్చవు."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bunlar bu iPhone’da saklanır. Hiçbir bilgisayarın ayarlarını değiştirmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ці параметри зберігаються на цьому iPhone. Вони не змінюють параметрів жодного комп’ютера."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یہ اس iPhone پر محفوظ رہتی ہیں۔ یہ کسی کمپیوٹر کی سیٹنگز نہیں بدلتیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些设置保存在此 iPhone 上，不会更改任何电脑的设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這些設定儲存在此 iPhone 上，不會更改任何電腦的設定。"
          }
        }
      }
