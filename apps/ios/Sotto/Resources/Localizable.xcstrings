          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poistaminen saa myös tietokoneen %@ unohtamaan tämän iPhonen, kun siihen saadaan yhteys. Ketjut jäävät tietokoneelle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
