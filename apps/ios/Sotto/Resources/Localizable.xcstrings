            "value" : "Než začnete vlákno, znovu připojte počítač na kartě Počítače."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opret forbindelse til en computer igen i Computere, før du starter en tråd."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbinde unter „Computer“ einen Computer neu, bevor du einen Thread startest."
          }
