    "The computer may already have created it. Check its projects and threads first. Dismissing sends nothing." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ربما أنشأه الكمبيوتر بالفعل. تحقق من مشاريعه ومحادثاته أولًا. التجاهل لا يرسل شيئًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কম্পিউটারটি হয়তো এটি আগেই তৈরি করেছে। আগে এর প্রজেক্ট ও থ্রেড দেখে নিন। বাদ দিলে কিছুই পাঠানো হয় না।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Počítač to možná už vytvořil. Nejdřív zkontrolujte jeho projekty a vlákna. Zahozením se nic neodešle."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Computeren har måske allerede oprettet den. Tjek først dens projekter og tråde. Der sendes intet, når du afviser."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Computer hat sie womöglich schon erstellt. Prüfe zuerst seine Projekte und Threads. Beim Verwerfen wird nichts gesendet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο υπολογιστής ίσως το έχει ήδη δημιουργήσει. Ελέγξτε πρώτα τα έργα και τα νήματά του. Η απόρριψη δεν στέλνει τίποτα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The computer may already have created it. Check its projects and threads first. Dismissing sends nothing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es posible que el ordenador ya lo haya creado. Revisa primero sus proyectos e hilos. Al descartarla no se envía nada."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es posible que la computadora ya lo haya creado. Revisa primero sus proyectos e hilos. Al descartarla no se envía nada."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es posible que la computadora ya lo haya creado. Revisa primero sus proyectos e hilos. Al descartarla no se envía nada."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tietokone on ehkä jo luonut sen. Tarkista ensin sen projektit ja ketjut. Hylkääminen ei lähetä mitään."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’ordinateur l’a peut-être déjà créé. Vérifiez d’abord ses projets et ses fils. Ignorer n’envoie rien."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हो सकता है कंप्यूटर ने इसे पहले ही बना दिया हो। पहले इसके प्रोजेक्ट और थ्रेड जाँच लें। हटाने से कुछ नहीं भेजा जाता।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lehet, hogy a számítógép már létrehozta. Előbb nézd meg a projektjeit és szálait. Az elvetés nem küld semmit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il computer potrebbe averlo già creato. Controlla prima i suoi progetti e thread. Ignorando non viene inviato nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コンピュータですでに作成されている可能性があります。先にそのプロジェクトとスレッドを確認してください。閉じても何も送信されません。"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कॉम्प्युटरने ते आधीच तयार केले असू शकते. आधी त्याचे प्रोजेक्ट आणि थ्रेड तपासा. काढल्याने काहीही पाठवले जात नाही."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datamaskinen kan allerede ha opprettet den. Sjekk prosjektene og trådene der først. Å avvise sender ingenting."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Misschien heeft de computer het al aangemaakt. Bekijk eerst de projecten en threads. Verwijderen verstuurt niets."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Komputer mógł już to utworzyć. Najpierw sprawdź jego projekty i wątki. Odrzucenie niczego nie wysyła."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O computador talvez já a tenha criado. Confira os projetos e as conversas dele primeiro. Descartar não envia nada."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O computador pode já a ter criado. Verifique primeiro os projetos e as conversas. Descartar não envia nada."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este posibil ca computerul să o fi creat deja. Verifică mai întâi proiectele și firele lui. Renunțarea nu trimite nimic."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datorn kan redan ha skapat den. Kontrollera dess projekt och trådar först. Inget skickas när du avfärdar."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "கணினி இதை ஏற்கனவே உருவாக்கியிருக்கலாம். முதலில் அதன் ப்ராஜெக்ட்களையும் த்ரெட்களையும் சரிபார்க்கவும். நிராகரித்தால் எதுவும் அனுப்பப்படாது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "కంప్యూటర్ దీన్ని ఇప్పటికే సృష్టించి ఉండవచ్చు. ముందుగా దాని ప్రాజెక్ట్‌లను, థ్రెడ్‌లను తనిఖీ చేయండి. విస్మరిస్తే ఏదీ పంపబడదు."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilgisayar bunu zaten oluşturmuş olabilir. Önce projelerini ve sohbetlerini kontrol edin. Kapatmak hiçbir şey göndermez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можливо, комп’ютер уже створив його. Спершу перевірте його проєкти й треди. Відхилення нічого не надсилає."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ہو سکتا ہے کمپیوٹر اسے پہلے ہی بنا چکا ہو۔ پہلے اس کے پروجیکٹس اور تھریڈز چیک کریں۔ ختم کرنے سے کچھ نہیں بھیجا جاتا۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "电脑可能已经创建了它。请先查看其项目和会话。忽略不会发送任何内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "電腦可能已經建立了它。請先查看其專案和對話。忽略不會傳送任何內容。"
          }
        }
      }
