    "Connection lost. Work carries on on the computer. Reconnect to check the thread." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انقطع الاتصال. يستمر العمل على الكمبيوتر. أعد الاتصال للتحقق من المحادثة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সংযোগ বিচ্ছিন্ন হয়েছে। কম্পিউটারে কাজ চলতে থাকে। থ্রেডটি দেখতে আবার সংযোগ করুন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Připojení ztraceno. Práce na počítači pokračuje. Chcete-li zkontrolovat vlákno, připojte se znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
