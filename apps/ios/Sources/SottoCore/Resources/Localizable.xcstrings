        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आत्ता %@ वरून GitHub पर्यंत पोहोचता येत नाही, त्यामुळे Sotto पुल रिक्वेस्ट वाचू शकले नाही. काहीही गमावले नाही. ते पुन्हा ऑनलाइन आल्यावर प्रयत्न करा."
          }
        },
        "nb" : {
