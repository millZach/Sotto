        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher ne s’exécute pas sur %@. Démarrez-le là-bas pour joindre des photos."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ पर Watcher नहीं चल रहा है। फ़ोटो अटैच करने के लिए उसे वहाँ शुरू करें।"
