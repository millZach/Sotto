    "This computer cannot keep files yet. Update Sotto there to attach them." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يستطيع هذا الكمبيوتر حفظ الملفات بعد. حدّث Sotto عليه لإرفاقها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই কম্পিউটার এখনও ফাইল রাখতে পারে না। ফাইল যোগ করতে সেখানে Sotto আপডেট করুন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento počítač zatím nemůže uchovávat soubory. Chcete-li je přikládat, aktualizujte tam Sotto."
