    "Edits files in the project without asking. Asks before commands." : {
      "comment" : "What a thread does under Allow edits.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعدّل الملفات في المشروع دون سؤال. ويسأل قبل الأوامر."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "জিজ্ঞাসা না করে প্রজেক্টের ফাইল সম্পাদনা করে। কমান্ডের আগে জিজ্ঞাসা করে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upravuje soubory v projektu bez ptaní. Před příkazy se zeptá."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redigerer filer i projektet uden at spørge. Spørger før kommandoer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bearbeitet Dateien im Projekt ohne Nachfrage. Fragt vor Befehlen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επεξεργάζεται αρχεία στο έργο χωρίς να ρωτά. Ρωτά πριν από εντολές."
