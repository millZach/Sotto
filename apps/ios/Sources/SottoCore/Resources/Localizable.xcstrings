    "Watcher isn’t running on %@. Start it there to attach photos." : {
      "comment" : "%@ is the computer's name, such as forge",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher لا يعمل على %@. شغّله هناك لإرفاق الصور."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@-এ Watcher চলছে না। ছবি যোগ করতে সেখানে এটি চালু করুন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher na %@ neběží. Chcete-li přikládat fotky, spusťte ho tam."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher kører ikke på %@. Start den der for at vedhæfte billeder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher läuft nicht auf %@. Starte ihn dort, um Fotos anzuhängen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο Watcher δεν εκτελείται στον υπολογιστή %@. Ξεκινήστε τον εκεί για να επισυνάψετε φωτογραφίες."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher isn’t running on %@. Start it there to attach photos."
          }
        },
        "es" : {
          "stringUnit" : {
