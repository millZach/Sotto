        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Watcher não está em execução em %@. Inicie-o lá para anexar fotografias."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher nu rulează pe %@. Pornește-l acolo pentru a atașa fotografii."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher körs inte på %@. Starta den där för att bifoga bilder."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ இல் Watcher இயங்கவில்லை. படங்களைச் சேர்க்க அங்கே அதைத் தொடங்கவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@లో Watcher నడవడం లేదు. ఫోటోలను జోడించడానికి అక్కడ దాన్ని ప్రారంభించండి."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher %@ üzerinde çalışmıyor. Fotoğraf eklemek için orada başlatın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher не запущено на %@. Запустіть його там, щоб додавати фото."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ پر Watcher نہیں چل رہا۔ تصاویر منسلک کرنے کے لیے اسے وہاں شروع کریں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher 未在 %@ 上运行。请在那里启动它后再附加照片。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher 未在 %@ 上執行。請在那裡啟動它後再附加照片。"
          }
        }
      }
    },
    "Watcher’s model can’t take photos. Change Watcher’s model on %@ to attach them." : {
