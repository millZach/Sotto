        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "கடைசி அனுமதி மாற்றத்தை ஏஜென்ட் உறுதிப்படுத்தியதும் மாற்றலாம்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
