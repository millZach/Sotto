    "Sotto can’t take what was shared. Nothing was saved." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يستطيع Sotto أخذ ما تمت مشاركته. لم يُحفظ شيء."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "যা শেয়ার করা হয়েছে Sotto তা নিতে পারে না। কিছুই সংরক্ষিত হয়নি।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sotto nemůže přijmout, co bylo sdíleno. Nic nebylo uloženo."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sotto kan ikke tage imod det delte. Intet blev gemt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sotto kann das Geteilte nicht annehmen. Nichts wurde gespeichert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Sotto δεν μπορεί να δεχτεί ό,τι μοιραστήκατε. Δεν αποθηκεύτηκε τίποτα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sotto can’t take what was shared. Nothing was saved."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sotto no puede recibir lo que has compartido. No se ha guardado nada."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sotto no puede recibir lo que compartiste. No se guardó nada."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sotto no puede recibir lo que compartiste. No se guardó nada."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sotto ei voi ottaa vastaan jaettua. Mitään ei tallennettu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sotto ne peut pas recevoir ce qui a été partagé. Rien n’a été enregistré."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जो शेयर किया गया, Sotto उसे नहीं ले सकता। कुछ भी सहेजा नहीं गया।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Sotto nem tudja fogadni a megosztott tartalmat. Semmi sem lett mentve."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sotto non può accettare ciò che è stato condiviso. Non è stato salvato nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共有された内容は Sotto で受け取れません。何も保存されていません。"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जे शेअर केले ते Sotto घेऊ शकत नाही. काहीही जतन केले नाही."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sotto kan ikke ta imot det som ble delt. Ingenting ble lagret."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sotto kan wat er gedeeld is niet aannemen. Er is niets bewaard."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sotto nie może przyjąć udostępnionych treści. Nic nie zapisano."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Sotto não pode receber o que foi compartilhado. Nada foi salvo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Sotto não pode receber o que foi partilhado. Nada foi guardado."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sotto nu poate primi ce s-a partajat. Nu s-a salvat nimic."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sotto kan inte ta emot det som delades. Inget sparades."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "பகிரப்பட்டதை Sotto ஏற்க முடியாது. எதுவும் சேமிக்கப்படவில்லை."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "షేర్ చేసినదాన్ని Sotto తీసుకోలేదు. ఏదీ సేవ్ కాలేదు."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sotto paylaşılanı alamıyor. Hiçbir şey kaydedilmedi."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sotto не може прийняти те, чим поділилися. Нічого не збережено."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جو شیئر کیا گیا وہ Sotto نہیں لے سکتا۔ کچھ بھی محفوظ نہیں ہوا۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sotto 无法接收所分享的内容。未保存任何内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sotto 無法接收所分享的內容。未儲存任何內容。"
