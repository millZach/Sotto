          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHubiin ei juuri nyt saada yhteyttä tietokoneelta %@, joten Sotto ei voinut lukea pull requestia. Mitään ei kadonnut. Yritä uudelleen, kun yhteys palaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub est injoignable depuis %@ pour l’instant, Sotto n’a donc pas pu lire la pull request. Rien n’a été perdu. Réessayez quand la connexion sera rétablie."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अभी %@ से GitHub तक नहीं पहुँचा जा सकता, इसलिए Sotto पुल रिक्वेस्ट नहीं पढ़ सका। कुछ भी नहीं खोया। इसके फिर से ऑनलाइन होने पर कोशिश करें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A GitHub most nem érhető el innen: %@, ezért a Sotto nem tudta beolvasni a pull requestet. Semmi sem veszett el. Próbáld újra, ha ismét online."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al momento GitHub non è raggiungibile da %@, quindi Sotto non ha potuto leggere la pull request. Non è andato perso nulla. Riprova quando la connessione torna disponibile."
