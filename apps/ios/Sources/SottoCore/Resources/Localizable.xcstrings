    "Sotto wakes this thread when a check fails, the checks pass, someone reviews, it conflicts or it merges." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يوقظ Sotto هذه المحادثة عندما يفشل فحص، أو تنجح الفحوصات، أو يراجعه أحد، أو يحدث تعارض، أو يُدمج."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কোনো চেক ব্যর্থ হলে, চেক পাস করলে, কেউ রিভিউ করলে, কনফ্লিক্ট হলে বা মার্জ হলে Sotto এই থ্রেডকে জাগায়।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sotto toto vlákno probudí, když kontrola selže, kontroly projdou, někdo přidá recenzi, vznikne konflikt nebo dojde ke sloučení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sotto vækker denne tråd, når et tjek mislykkes, tjekkene består, nogen gennemgår den, den får konflikter, eller den flettes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sotto weckt diesen Thread, wenn ein Check fehlschlägt, die Checks bestehen, jemand ein Review abgibt, ein Konflikt entsteht oder der Pull Request gemergt wird."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Sotto αφυπνίζει αυτό το νήμα όταν ένας έλεγχος αποτύχει, οι έλεγχοι περάσουν, κάποιος κάνει αξιολόγηση, προκύψει διένεξη ή γίνει συγχώνευση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sotto wakes this thread when a check fails, the checks pass, someone reviews, it conflicts or it merges."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sotto despierta a este hilo cuando falla una comprobación, se superan las comprobaciones, alguien hace una revisión, hay conflictos o se fusiona."
          }
        },
        "es-419" : {
          "stringUnit" : {
