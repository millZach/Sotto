    "Runs anything without asking, in the project and outside it." : {
      "comment" : "What a thread does under Full access.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يشغّل أي شيء دون سؤال، داخل المشروع وخارجه."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "জিজ্ঞাসা না করে প্রজেক্টের ভেতরে ও বাইরে যেকোনো কিছু চালায়।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spustí cokoli bez ptaní, v projektu i mimo něj."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kører hvad som helst uden at spørge, i projektet og uden for det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Führt alles ohne Nachfrage aus, im Projekt und außerhalb."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εκτελεί οτιδήποτε χωρίς να ρωτά, μέσα και έξω από το έργο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Runs anything without asking, in the project and outside it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ejecuta lo que sea sin preguntar, dentro y fuera del proyecto."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ejecuta lo que sea sin preguntar, dentro y fuera del proyecto."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ejecuta lo que sea sin preguntar, dentro y fuera del proyecto."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suorittaa mitä tahansa kysymättä, projektissa ja sen ulkopuolella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exécute tout sans demander, dans le projet comme en dehors."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बिना पूछे कुछ भी चलाता है, प्रोजेक्ट के अंदर और बाहर।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kérdezés nélkül bármit futtat, a projekten belül és kívül is."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esegue qualsiasi cosa senza chiedere, dentro e fuori dal progetto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロジェクトの内外を問わず、確認なしで何でも実行します。"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "न विचारता काहीही चालवतो, प्रोजेक्टमध्ये आणि त्याबाहेरही."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kjører hva som helst uten å spørre, i prosjektet og utenfor."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voert alles uit zonder te vragen, in het project en daarbuiten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uruchamia wszystko bez pytania, w projekcie i poza nim."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Executa qualquer coisa sem perguntar, dentro e fora do projeto."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Executa qualquer coisa sem perguntar, dentro e fora do projeto."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rulează orice fără să întrebe, în proiect și în afara lui."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kör vad som helst utan att fråga, i projektet och utanför."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ப்ராஜெக்ட்டுக்குள்ளும் வெளியிலும், கேட்காமலேயே எதையும் இயக்கும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ప్రాజెక్ట్ లోపలా బయటా, అడగకుండానే దేన్నైనా అమలు చేస్తుంది."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Projenin içinde ve dışında, sormadan her şeyi çalıştırır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виконує будь-що без запиту, у проєкті й поза ним."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پروجیکٹ کے اندر اور باہر، بغیر پوچھے کچھ بھی چلاتا ہے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无需询问即可运行任何内容，无论在项目内外。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不必詢問即可執行任何內容，無論在專案內外。"
          }
        }
      }
    },
    "Saved. Open Sotto to add it to your message." : {
