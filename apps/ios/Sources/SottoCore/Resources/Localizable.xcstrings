        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. GitHub no dejó que Sotto leyera todas las comprobaciones"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. GitHub ei antanut Sotton lukea kaikkia tarkistuksia"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. GitHub n’a pas laissé Sotto lire toutes les vérifications"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@। GitHub ने Sotto को हर चेक पढ़ने नहीं दिया"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. A GitHub nem engedte, hogy a Sotto minden ellenőrzést beolvasson"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. GitHub non ha consentito a Sotto di leggere tutti i controlli"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@。GitHub が Sotto にすべてのチェックの読み込みを許可しませんでした"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. GitHub ने Sotto ला प्रत्येक चेक वाचू दिला नाही"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. GitHub lot ikke Sotto lese alle sjekkene"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. GitHub liet Sotto niet elke check lezen"
          }
        },
        "pl" : {
