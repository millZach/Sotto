    "Up to 2.5x faster output, at twice the price per token." : {
      "comment" : "What Claude Code's Fast speed costs.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مخرجات أسرع بما يصل إلى 2.5 مرة، بضعف السعر لكل رمز."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2.5 গুণ পর্যন্ত দ্রুত আউটপুট, প্রতি টোকেনে দ্বিগুণ দামে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Až 2,5× rychlejší výstup za dvojnásobnou cenu za token."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Op til 2,5 gange hurtigere output til den dobbelte pris pr. token."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bis zu 2,5-mal schnellere Ausgabe zum doppelten Preis pro Token."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Έως 2,5 φορές ταχύτερη έξοδος, στη διπλάσια τιμή ανά token."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Up to 2.5x faster output, at twice the price per token."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respuestas hasta 2,5 veces más rápidas, al doble de precio por token."
          }
        },
