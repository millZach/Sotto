    "The computer didn't finish connecting. Work carries on there. Try connecting again." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يُكمل الكمبيوتر الاتصال. يستمر العمل هناك. حاول الاتصال مجددًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কম্পিউটারটি সংযোগ শেষ করেনি। ওখানে কাজ চলতে থাকে। আবার সংযোগ করার চেষ্টা করুন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Počítač nedokončil připojení. Práce tam pokračuje. Zkuste se připojit znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Computeren fik ikke oprettet forbindelsen færdig. Arbejdet fortsætter der. Prøv at oprette forbindelse igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Computer hat die Verbindung nicht abgeschlossen. Die Arbeit geht dort weiter. Versuch erneut, dich zu verbinden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο υπολογιστής δεν ολοκλήρωσε τη σύνδεση. Η εργασία συνεχίζεται εκεί. Δοκιμάστε να συνδεθείτε ξανά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The computer didn't finish connecting. Work carries on there. Try connecting again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El ordenador no ha terminado de conectarse. El trabajo continúa allí. Vuelve a intentar conectarte."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La computadora no terminó de conectarse. El trabajo continúa allí. Vuelve a intentar conectarte."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La computadora no terminó de conectarse. El trabajo continúa allí. Vuelve a intentar conectarte."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tietokone ei saanut yhteyttä valmiiksi. Työ jatkuu siellä. Yritä yhdistää uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’ordinateur n’a pas terminé la connexion. Le travail continue là-bas. Essayez de vous reconnecter."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कंप्यूटर का कनेक्ट होना पूरा नहीं हुआ। वहाँ काम चलता रहता है। फिर से कनेक्ट करने की कोशिश करें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A számítógép nem fejezte be a csatlakozást. A munka ott folytatódik. Próbálj újra csatlakozni."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il computer non ha completato la connessione. Il lavoro continua lì. Prova a connetterti di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コンピュータへの接続が完了しませんでした。作業は相手側で続いています。もう一度接続してください。"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कॉम्प्युटरचे कनेक्ट होणे पूर्ण झाले नाही. तिथे काम चालूच राहते. पुन्हा कनेक्ट करून पाहा."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datamaskinen ble ikke ferdig med å koble til. Arbeidet fortsetter der. Prøv å koble til igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De computer heeft de verbinding niet voltooid. Het werk gaat daar door. Probeer opnieuw verbinding te maken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Komputer nie dokończył łączenia. Praca trwa tam dalej. Spróbuj połączyć się ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O computador não terminou de conectar. O trabalho continua lá. Tente conectar de novo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O computador não terminou a ligação. O trabalho continua lá. Tente ligar novamente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Computerul nu a terminat conectarea. Lucrul continuă acolo. Încearcă din nou să te conectezi."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datorn slutförde inte anslutningen. Arbetet fortsätter där. Försök ansluta igen."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "கணினி இணைப்பை முடிக்கவில்லை. அங்கே வேலை தொடர்கிறது. மீண்டும் இணைக்க முயலவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "కంప్యూటర్ కనెక్ట్ కావడం పూర్తి కాలేదు. అక్కడ పని కొనసాగుతుంది. మళ్లీ కనెక్ట్ చేయడానికి ప్రయత్నించండి."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilgisayar bağlanmayı tamamlamadı. Çalışma orada sürüyor. Yeniden bağlanmayı deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Комп’ютер не завершив підключення. Робота там триває. Спробуйте підключитися ще раз."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کمپیوٹر نے کنیکٹ ہونا مکمل نہیں کیا۔ وہاں کام جاری رہتا ہے۔ دوبارہ کنیکٹ کرنے کی کوشش کریں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "电脑未完成连接。那边的工作会继续进行。请再次尝试连接。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "電腦未完成連線。那邊的工作會繼續進行。請再次嘗試連線。"
          }
        }
      }
    },
