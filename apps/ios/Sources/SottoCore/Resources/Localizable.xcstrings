            "state" : "translated",
            "value" : "Watcher kjører ikke på %@. Start den der for å legge ved bilder."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher draait niet op %@. Start Watcher daar om foto’s toe te voegen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher nie działa na %@. Uruchom go tam, aby załączać zdjęcia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Watcher não está em execução em %@. Inicie-o lá para anexar fotos."
          }
