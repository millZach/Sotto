            "value" : "Connection lost. Work carries on on the computer. Reconnect to check the thread."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ha perdido la conexión. El trabajo continúa en el ordenador. Vuelve a conectarte para revisar el hilo."
