    "Plans the work and runs it as a team of agents. Uses many more tokens." : {
      "comment" : "What the Ultracode effort level does.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يخطط للعمل وينفّذه كفريق من الوكلاء. يستهلك رموزًا أكثر بكثير."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কাজের পরিকল্পনা করে এবং এজেন্টদের একটি দল হিসেবে তা চালায়। অনেক বেশি টোকেন খরচ করে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naplánuje práci a provede ji jako tým agentů. Spotřebuje mnohem víc tokenů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planlægger arbejdet og udfører det som et hold af agenter. Bruger mange flere tokens."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plant die Arbeit und erledigt sie als Team von Agenten. Verbraucht deutlich mehr Tokens."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σχεδιάζει τη δουλειά και την εκτελεί ως ομάδα πρακτόρων. Χρησιμοποιεί πολύ περισσότερα tokens."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plans the work and runs it as a team of agents. Uses many more tokens."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planifica el trabajo y lo ejecuta como un equipo de agentes. Usa muchos más tokens."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planifica el trabajo y lo ejecuta como un equipo de agentes. Usa muchos más tokens."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planifica el trabajo y lo ejecuta como un equipo de agentes. Usa muchos más tokens."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suunnittelee työn ja tekee sen agenttitiiminä. Käyttää paljon enemmän tokeneita."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planifie le travail et l’exécute avec une équipe d’agents. Consomme beaucoup plus de tokens."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "काम की योजना बनाता है और उसे एजेंटों की टीम के रूप में चलाता है। कहीं ज़्यादा टोकन इस्तेमाल करता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Megtervezi a munkát, és ügynökökből álló csapatként végzi el. Sokkal több tokent használ."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pianifica il lavoro e lo esegue come un team di agenti. Usa molti più token."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "作業を計画し、エージェントのチームで実行します。トークンを大幅に多く使います。"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कामाचे नियोजन करतो आणि एजंटांच्या टीमप्रमाणे ते चालवतो. खूप जास्त टोकन वापरतो."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planlegger arbeidet og utfører det som et team av agenter. Bruker mange flere tokens."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plant het werk en voert het uit als een team van agents. Gebruikt veel meer tokens."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planuje pracę i wykonuje ją jako zespół agentów. Zużywa znacznie więcej tokenów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planeja o trabalho e o executa como uma equipe de agentes. Usa muito mais tokens."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planeia o trabalho e executa-o como uma equipa de agentes. Usa muito mais tokens."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planifică munca și o execută ca o echipă de agenți. Folosește mult mai mulți tokeni."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planerar arbetet och utför det som ett team av agenter. Använder många fler tokens."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "பணியைத் திட்டமிட்டு, ஏஜென்ட்களின் குழுவாக இயக்கும். மிக அதிக டோக்கன்களைப் பயன்படுத்தும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "పనిని ప్లాన్ చేసి, ఏజెంట్‌ల బృందంగా అమలు చేస్తుంది. చాలా ఎక్కువ టోకెన్‌లను వాడుతుంది."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İşi planlar ve bir ajan ekibi olarak yürütür. Çok daha fazla token kullanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Планує роботу й виконує її командою агентів. Витрачає значно більше токенів."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
