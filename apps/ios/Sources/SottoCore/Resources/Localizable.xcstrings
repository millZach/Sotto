    "GitHub can’t be reached from %@ right now, so Sotto couldn’t read the pull request. Nothing was lost. Try again when it’s back online." : {
      "comment" : "Every %@ is the computer's name, or the computer",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتعذّر الوصول إلى GitHub من %@ الآن، لذا تعذّر على Sotto قراءة طلب السحب. لم يُفقد شيء. حاول مرة أخرى عندما يعود الاتصال."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এখন %@ থেকে GitHub-এ পৌঁছানো যাচ্ছে না, তাই Sotto পুল রিকোয়েস্টটি পড়তে পারেনি। কিছুই হারায়নি। এটি আবার অনলাইনে এলে আবার চেষ্টা করুন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub je teď z %@ nedostupný, takže pull request se nepodařilo načíst. Nic se neztratilo. Zkuste to znovu, až bude zase online."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub kan ikke nås fra %@ lige nu, så Sotto kunne ikke læse pull requesten. Intet gik tabt. Prøv igen, når den er online igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub ist von %@ aus gerade nicht erreichbar, daher konnte Sotto den Pull Request nicht lesen. Nichts ging verloren. Versuch es erneut, wenn die Verbindung wieder da ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν υπάρχει πρόσβαση στο GitHub από εκεί (%@) αυτή τη στιγμή, οπότε το Sotto δεν μπόρεσε να διαβάσει το pull request. Δεν χάθηκε τίποτα. Δοκιμάστε ξανά όταν επανέλθει η σύνδεση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub can’t be reached from %@ right now, so Sotto couldn’t read the pull request. Nothing was lost. Try again when it’s back online."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede conectar con GitHub desde %@ en este momento, así que Sotto no ha podido leer el pull request. No se ha perdido nada. Inténtalo de nuevo cuando vuelva a estar en línea."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede conectar con GitHub desde %@ en este momento, así que Sotto no pudo leer el pull request. No se perdió nada. Inténtalo de nuevo cuando vuelva a estar en línea."
          }
        },
        "es-MX" : {
          "stringUnit" : {
