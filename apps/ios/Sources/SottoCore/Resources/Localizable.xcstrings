    "Can change once the agent confirms the last permission change." : {
      "comment" : "Why a thread setting can't be changed now: the agent hasn't confirmed a permission change",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن تغييره بعد أن يؤكد الوكيل آخر تغيير في الأذونات."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এজেন্ট শেষ অনুমতি পরিবর্তনটি নিশ্চিত করলে বদলানো যাবে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Půjde změnit, až agent potvrdí poslední změnu oprávnění."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan ændres, når agenten har bekræftet den seneste ændring af tilladelser."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lässt sich ändern, sobald der Agent die letzte Änderung der Berechtigungen bestätigt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μπορεί να αλλάξει μόλις ο πράκτορας επιβεβαιώσει την τελευταία αλλαγή αδειών."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Can change once the agent confirms the last permission change."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se podrá cambiar cuando el agente confirme el último cambio de permisos."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se podrá cambiar cuando el agente confirme el último cambio de permisos."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se podrá cambiar cuando el agente confirme el último cambio de permisos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voi muuttaa, kun agentti vahvistaa viimeisimmän lupamuutoksen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modifiable une fois que l’agent aura confirmé le dernier changement d’autorisations."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एजेंट के पिछले अनुमति बदलाव की पुष्टि करने पर बदला जा सकता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Módosítható, amint az ügynök megerősíti az engedélyek legutóbbi módosítását."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si può cambiare quando l’agente conferma l’ultima modifica alle autorizzazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エージェントが前回の許可の変更を確認すると変更できます。"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एजंटने शेवटच्या परवानगी बदलाची पुष्टी केल्यावर बदलता येईल."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan endres når agenten har bekreftet den siste endringen av tillatelser."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan worden gewijzigd zodra de agent de laatste wijziging van toestemmingen bevestigt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
