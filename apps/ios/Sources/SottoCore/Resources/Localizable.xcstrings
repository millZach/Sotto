          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbindung verloren. Die Arbeit geht auf dem Computer weiter. Verbinde dich neu, um den Thread zu prüfen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η σύνδεση χάθηκε. Η εργασία συνεχίζεται στον υπολογιστή. Συνδεθείτε ξανά για να ελέγξετε το νήμα."
          }
        },
        "en" : {
