    "%@. GitHub did not let Sotto read every check" : {
      "comment" : "%@ is how the checks stand, such as 1 failing, 9 passed",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. لم يسمح GitHub لـ Sotto بقراءة كل الفحوصات"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@। GitHub Sotto-কে সব চেক পড়তে দেয়নি"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. GitHub nedovolil Sotto načíst všechny kontroly"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. GitHub lod ikke Sotto læse alle tjek"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. GitHub hat Sotto nicht jeden Check lesen lassen"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Το GitHub δεν επέτρεψε στο Sotto να διαβάσει όλους τους ελέγχους"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. GitHub did not let Sotto read every check"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. GitHub no ha dejado que Sotto lea todas las comprobaciones"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. GitHub no dejó que Sotto leyera todas las comprobaciones"
          }
