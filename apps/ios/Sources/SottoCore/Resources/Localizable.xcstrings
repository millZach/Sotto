            "state" : "translated",
            "value" : "A Watcher nem fut a(z) %@ számítógépen. A fotók csatolásához indítsd el ott."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watcher non è in esecuzione su %@. Avvialo lì per allegare foto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ で Watcher が実行されていません。写真を添付するには、そちらで Watcher を開始してください。"
          }
