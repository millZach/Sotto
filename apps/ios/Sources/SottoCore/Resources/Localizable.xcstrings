    "Takes longer and catches more." : {
      "comment" : "What the High effort level does.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستغرق وقتًا أطول ويلتقط المزيد."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "বেশি সময় নেয় এবং বেশি ধরতে পারে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trvá déle a zachytí víc."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tager længere tid og fanger mere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dauert länger und findet mehr."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Παίρνει περισσότερο χρόνο και εντοπίζει περισσότερα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Takes longer and catches more."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarda más y detecta más cosas."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarda más y detecta más cosas."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarda más y detecta más cosas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kestää kauemmin ja huomaa enemmän."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus long, mais repère davantage."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ज़्यादा समय लेता है और ज़्यादा पकड़ता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tovább tart, és többet észrevesz."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richiede più tempo e coglie di più."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "時間はかかりますが、より多くの問題に気づきます。"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जास्त वेळ घेतो आणि जास्त गोष्टी पकडतो."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tar lengre tid og fanger opp mer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duurt langer en vangt meer op."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trwa dłużej i wyłapuje więcej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leva mais tempo e percebe mais."
          }
        },
        "pt-PT" : {
