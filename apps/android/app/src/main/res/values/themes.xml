<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose draws everything; the window only needs Sotto's dark canvas before the first frame. -->
    <style name="Theme.Sotto" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/canvas_dark</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <color name="canvas_dark">#040507</color>
</resources>
