# The release owner updates pkgver and the archive checksum after verifying a release on forge.
pkgname=sotto-bin
pkgver=0.1.41
pkgrel=1
pkgdesc='Dictation and manual coding threads'
arch=('x86_64')
url='https://github.com/millZach/Sotto-releases'
license=('MIT')
provides=('sotto')
conflicts=('sotto')
depends=('alsa-lib' 'at-spi2-core' 'cairo' 'dbus' 'expat' 'gcc-libs'
         'glib2' 'glibc' 'gtk3' 'hicolor-icon-theme' 'libcups' 'libnotify'
         'libx11' 'libxcb' 'libxcomposite' 'libxdamage' 'libxext' 'libxfixes'
         'libxkbcommon' 'libxrandr' 'mesa' 'nspr' 'nss' 'pango' 'systemd-libs'
         'xdg-utils' 'wl-clipboard' 'wtype' 'libsecret')
optdepends=('gnome-keyring: unlock and save credentials through Secret Service')
options=('!strip')
# Stable's release version is pkgver. A Sotto Owl build sets the Owl version and its archive name here, because pacman
# cannot hold the Owl's hyphen (scripts/linux-release.mjs, ADR-0099).
_version="${pkgver}"
_archive_name="Sotto-${_version}-linux-x64"
_archive="${_archive_name}.tar.gz"
# Local verification uses an absolute path and the same checksum checks as a release download.
_source_url="https://github.com/millZach/Sotto-releases/releases/download/v${_version}/${_archive}"
if [[ -n ${SOTTO_TARBALL:-} ]]; then
  _source_url="file://${SOTTO_TARBALL}"
fi
source=("${_archive}::${_source_url}"
        'sotto' 'sotto.desktop' 'install.sh'
        'sotto-48.png' 'sotto-128.png' 'sotto-256.png')
# Filled from the verified archive and package sources; never use SKIP for the release archive.
sha256sums=('4f78ca2eea793d9bad5913c98056d6033b85a7330f86e7b5f436cb49ebc3a6d3'
            'b6c787d65d76cb6d3b249e237361b5991d70a96e762f8893c96cd6d567e70e86'
            '79b1f65a213d781994e77d887a451e19ad6282cc352e91507aaf8b6ca97d92d0'
            '35c949114cc26f1e34500cd853b8e0aee2fe770789b19247002095df07d394e6'
            '2c3f081fbb8de1d668efc065d8e1dd43b37a290062b985db237a6b4a6d56daad'
            '598060d14b5155dba4587679e768571ecdc30f15072ac7ab4d6dc1e074f27256'
            '0f8c2997a268265291192476d8b97a19bcdd125ed6d6944d1ddf7a4292baa645')

package() {
  install -d "${pkgdir}/opt/sotto"
  cp -a "${srcdir}/${_archive_name}/." "${pkgdir}/opt/sotto/"
  chown root:root "${pkgdir}/opt/sotto/chrome-sandbox"
  chmod 4755 "${pkgdir}/opt/sotto/chrome-sandbox"
  install -Dm755 "${srcdir}/sotto" "${pkgdir}/opt/sotto/bin/sotto"
  install -d "${pkgdir}/usr/bin"
  ln -s /opt/sotto/bin/sotto "${pkgdir}/usr/bin/sotto"
  install -Dm644 "${srcdir}/sotto.desktop" "${pkgdir}/usr/share/applications/sotto.desktop"
  for size in 48 128 256; do
    install -Dm644 "${srcdir}/sotto-${size}.png" "${pkgdir}/usr/share/icons/hicolor/${size}x${size}/apps/sotto.png"
  done
  install -Dm644 "${pkgdir}/opt/sotto/resources/LICENSE.md" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE.md"
  # The tarball carries every setup piece. Keep the public helper paths too.
  install -d "${pkgdir}/usr/share/sotto"
  cp -a "${pkgdir}/opt/sotto/resources/omarchy/." "${pkgdir}/usr/share/sotto/"
  install -Dm755 "${srcdir}/install.sh" "${pkgdir}/usr/share/sotto/install.sh"
}
