    "surfaceOverlay": "{{ mix background foreground 10% }}",
    "text": "{{ foreground }}",
    "textMuted": "{{ mix foreground background 30% }}",
    "border": "{{ mix background foreground 15% }}",
    "input": "{{ mix background foreground 24% }}",
    "focus": "{{ accent }}",
    "accent": "{{ accent }}",
    "accentForeground": "{{ background }}",
