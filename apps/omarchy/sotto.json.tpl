{
  "version": 1,
  "id": "omarchy",
  "name": "Omarchy",
  "appearance": "{{ mode }}",
  "colors": {
    "canvas": "{{ background }}",
    "chrome": "{{ background }}",
    "toolbar": "{{ background }}",
    "toolbarForeground": "{{ foreground }}",
    "toolbarBorder": "{{ mix background foreground 14% }}",
    "toolbarControl": "{{ mix background foreground 6% }}",
