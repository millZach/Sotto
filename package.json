{
  "name": "talktype",
  "version": "0.1.0",
  "description": "Offline-first Windows dictation",
  "author": "TalkType",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && playwright test --workers=1",
    "model:prepare": "node scripts/prepare-model.mjs",
    "model:verify": "node scripts/verify-model.mjs",
    "package:dir": "npm run build && electron-builder --dir --win --x64",
    "package:win": "npm run build && electron-builder --win nsis --x64"
  },
  "license": "UNLICENSED",
  "type": "commonjs",
  "dependencies": {
    "@huggingface/transformers": "4.2.0",
    "lucide-react": "1.24.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "4.1.10",
    "electron": "43.1.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "10.7.0",
    "jsdom": "29.1.1",
    "sharp": "0.34.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.63.0",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  }
}
