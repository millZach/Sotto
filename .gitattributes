# The design capture spec compares this file byte for byte with the LF text it writes, so a Windows
# checkout with core.autocrlf must not turn it into CRLF.
artifacts/design/app-review/manifest.json text eol=lf

# The executable launcher must retain its Unix shebang in Windows checkouts too.
apps/omarchy/sotto text eol=lf
apps/omarchy/install.sh text eol=lf
apps/omarchy/PKGBUILD text eol=lf
apps/omarchy/sotto.desktop text eol=lf
