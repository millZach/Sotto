{
  "$schema": "https://www.unpkg.com/wrangler/config-schema.json",
  "name": "sotto-product-events",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-20",
  // Request logs would hold addresses, so neither Cloudflare's logs nor Logpush are on (ADR-0179).
  "observability": { "enabled": false },
  "logpush": false,
  // One address: the one the app and the README name.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "events.saysotto.com", "custom_domain": true }],
  // Per Cloudflare location, since the Worker reads no address. A sender posts about twice a minute, and a 429 only delays it.
  "ratelimits": [{ "name": "REQUESTS", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } }],
  "d1_databases": [{ "binding": "EVENTS", "database_name": "sotto-product-events", "database_id": "5dabf471-81e0-4647-93f4-d39cf91595d5" }],
  "triggers": { "crons": ["17 * * * *"] }
}
